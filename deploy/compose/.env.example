#
# Copy to .env and fill in. `docker compose` reads this automatically.

# --- Image (PIN BY DIGEST in production) -----------------------------------
# Default is the floating tag for convenience; for a verifiable deploy set the
# digest you verified with cosign (scripts/verify-release.sh / cosign verify):
#   OLIVARES_IMAGE=docker.io/olivaresai/olivares@sha256:<digest>
# docker.io is the official registry. ghcr.io/olivaresai/olivares is the fallback:
# same digest, same signatures, and no anonymous-pull rate limit.
OLIVARES_IMAGE=docker.io/olivaresai/olivares:latest

# --- Postgres override only (docker-compose.postgres.yml) ------------------
# The Postgres superuser password (used once, at cluster init).
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser
# The least-privilege olivares_app role password (engine connects as this).
OLIVARES_DB_PASSWORD=change-me-app
# Optional: pin the Postgres image by digest too.
# OLIVARES_POSTGRES_IMAGE=postgres@sha256:<digest>
