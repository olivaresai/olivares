{
  "name": "@olivaresai/backstage-plugin-olivares-backend",
  "version": "0.1.0",
  "description": "Backstage backend plugin: a read-only portal proxy that authenticates the Backstage user and forwards governed reads (inventory, live sessions, R/RW access-map + drift) to the Olivares AI control plane.",
  "license": "Apache-2.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "olivares",
    "pluginPackages": [
      "@olivaresai/backstage-plugin-olivares-backend"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --declaration --emitDeclarationOnly --outDir dist-types && backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "tsc -p tsconfig.test.json && node --test \".test-out/**/*.test.js\"",
    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-promise-router": "^4.1.1"
  },
  "peerDependencies": {
    "@backstage/backend-plugin-api": "*"
  },
  "devDependencies": {
    "@backstage/cli": "0.36.6",
    "@backstage/cli-defaults": "0.1.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "olivares",
    "ai-governance",
    "access-map",
    "proxy"
  ],
  "pnpm": {
    "overrides": {
      "nanoid": "^3.3.17",
      "tar": "^7.5.21",
      "browserslist": "^4.28.8",
      "fast-uri": "^3.1.8",
      "adm-zip": "^0.6.1",
      "undici": "7.29.1",
      "sockjs>uuid": "11.1.1",
      "@yarnpkg/core>got": "11.8.6"
    },
    "patchedDependencies": {
      "got@11.8.6": "../patches/got-11.8.6.patch"
    }
  }
}
