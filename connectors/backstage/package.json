{
  "name": "@olivaresai/backstage-plugin-catalog-backend-module-olivares",
  "version": "0.1.0",
  "description": "Backstage catalog backend module: an Olivares AI entity provider that publishes the Olivares estate into the Backstage Software Catalog (read-first), plus a scaffolder Template to register an agent with Olivares governance.",
  "license": "Apache-2.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "backstage": {
    "role": "backend-plugin-module",
    "pluginId": "catalog",
    "pluginPackages": [
      "@backstage/plugin-catalog-node"
    ],
    "pluginPackage": "@backstage/plugin-catalog-backend"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "files": [
    "src",
    "template",
    "examples"
  ],
  "scripts": {
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "build": "tsc --declaration --emitDeclarationOnly --outDir dist-types && backstage-cli package build"
  },
  "peerDependencies": {
    "@backstage/backend-plugin-api": "*",
    "@backstage/catalog-model": "*",
    "@backstage/plugin-catalog-node": "*"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "catalog",
    "entity-provider",
    "olivares",
    "ai-governance"
  ],
  "devDependencies": {
    "@backstage/cli": "0.36.6",
    "@backstage/cli-defaults": "0.1.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "^3.3.17",
      "tar": "^7.5.21",
      "browserslist": "^4.28.8",
      "fast-uri": "^3.1.8",
      "adm-zip": "^0.6.1",
      "undici": "7.29.1",
      "sockjs>uuid": "11.1.1",
      "@yarnpkg/core>got": "11.8.6"
    },
    "patchedDependencies": {
      "got@11.8.6": "patches/got-11.8.6.patch"
    }
  }
}
