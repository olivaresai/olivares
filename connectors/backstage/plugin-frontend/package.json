{
  "name": "@olivaresai/backstage-plugin-olivares",
  "version": "0.1.0",
  "description": "Backstage frontend plugin: a native portal view of the Olivares AI estate — agent/MCP/session inventory, live sessions, and the R/RW access-map + drift — plus entity tab/card, authenticated through the control plane's SSO/RBAC.",
  "license": "Apache-2.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "olivares",
    "pluginPackages": [
      "@olivaresai/backstage-plugin-olivares"
    ]
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsc --declaration --emitDeclarationOnly --outDir dist-types && backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "tsc -p tsconfig.test.json && node --test \".test-out/**/*.test.js\" && node --test tests/material-table.test.cjs",
    "clean": "backstage-cli package clean"
  },
  "peerDependencies": {
    "@backstage/catalog-model": "*",
    "@backstage/core-components": "*",
    "@backstage/core-plugin-api": "*",
    "@backstage/plugin-catalog-react": "*",
    "@material-ui/core": "^4.9.3",
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0",
    "react-dom": "^16.13.1 || ^17.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "0.36.6",
    "@backstage/cli-defaults": "0.1.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "olivares",
    "ai-governance",
    "access-map",
    "inventory",
    "sessions"
  ],
  "pnpm": {
    "overrides": {
      "nanoid": "^3.3.17",
      "tar": "^7.5.21",
      "browserslist": "^4.28.8",
      "fast-uri": "^3.1.8",
      "adm-zip": "^0.6.1",
      "undici": "7.29.1",
      "sockjs>uuid": "11.1.1",
      "prismjs": "1.30.0",
      "@octokit/request": "8.4.1",
      "@octokit/request-error": "5.1.1",
      "@octokit/plugin-paginate-rest": "9.2.2",
      "@yarnpkg/core>got": "11.8.6",
      "@material-table/core>uuid": "11.1.1"
    },
    "patchedDependencies": {
      "got@11.8.6": "../patches/got-11.8.6.patch",
      "@material-table/core@3.2.5": "../patches/material-table-core-3.2.5.patch"
    }
  }
}
