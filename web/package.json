{
  "name": "@olivaresai/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Olivares AI control plane web UI (embedded into the olivares binary via go:embed).",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "tokens": "node tokens/build.mjs && prettier --write src/styles/tokens.css",
    "tokens:check": "pnpm run tokens && git diff --exit-code -- src/styles/tokens.css",
    "build": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc -b",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "codegen": "node scripts/merge-openapi-codegen.mjs > ./openapi/.openapi.codegen.json && openapi-typescript ./openapi/.openapi.codegen.json -o src/lib/api/openapi.gen.ts; status=$?; rm -f ./openapi/.openapi.codegen.json; if [ $status -ne 0 ]; then exit $status; fi; prettier --write src/lib/api/openapi.gen.ts",
    "e2e": "pnpm run typecheck:e2e && playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "at": "pnpm build && node --experimental-strip-types e2e-visual/at-run.ts dark all dark && node --experimental-strip-types e2e-visual/at-run.ts light all light",
    "at:gate": "pnpm build && node --experimental-strip-types e2e-visual/at-run.ts dark all dark --gate && node --experimental-strip-types e2e-visual/at-run.ts light all light --gate"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.5",
    "@codemirror/view": "^6.43.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "3.4.15",
    "graphology": "0.26.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "recharts": "^3.10.1",
    "sigma": "3.0.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@tanstack/router-devtools": "^1.167.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "graphology-types": "0.24.8",
    "jsdom": "^30.1.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.8",
    "style-dictionary": "5.5.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "nanoid": "^3.3.17",
      "browserslist": "^4.28.8",
      "js-yaml": "4.3.2"
    }
  }
}
