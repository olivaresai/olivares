# Astro copies this file into dist. Keep the security.txt rule before the catch-all.
# Per-page CSP hashes are in the sealed HTML; frame-ancestors requires a response header.
# Only the catch-all may set the four required security headers.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# The assistants' files carry non-ASCII text. Measured 2026-10-18: robots.txt is served as plain
# text/plain, while a path with a rule here is served with the charset.
/llms.txt
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Content-Type: text/plain; charset=utf-8

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'none'
