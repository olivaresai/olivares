{
  // Olivares AI documentation — PREPROD. Serves the same `docs-site/dist` as production, on the
  // sandbox zone, so the release candidate can be reviewed before anything touches
  // `docs.olivares.ai`. Order 38 (three environments: .dev -> .preprod -> public).
  //
  // ⛔ THE HOSTNAME IS ONE LEVEL DEEP, AND THAT IS NOT A PREFERENCE — IT IS THE ONLY ONE THAT
  // SERVES TLS TODAY. The row named `docs.preprod.olivaresai.dev`. Measured 2026-08-29 with both
  // records live and a positive control:
  //
  //   https://hooks-sandbox.olivaresai.dev/   -> 200   (one level, the zone's existing convention)
  //   https://docs-preprod.olivaresai.dev/    -> 522   (one level: TLS TERMINATED, then Cloudflare
  //                                                     reached the 100:: discard origin — the
  //                                                     correct state before a route exists)
  //   https://docs.preprod.olivaresai.dev/    -> TLS HANDSHAKE FAILURE, no HTTP at all
  //
  // `GET /zones/{id}/ssl/certificate_packs` returns ZERO packs: this zone has Universal SSL only,
  // which covers the apex and `*.olivaresai.dev` — ONE label. A third-level name needs Advanced
  // Certificate Manager or Total TLS, both paid add-ons and both a decision that is not a lane's.
  // So the deliverable uses the name that works and the other record stays as evidence.
  //
  // ⛔ AND IT IS A ROUTE, NOT A `custom_domain`, for the same reason production is: the DNS record
  // `docs-preprod.olivaresai.dev` (AAAA 100::, proxied) was created explicitly under order 24's
  // create-only mandate, matching `hooks-sandbox` in this zone. A `custom_domain` would try to
  // manage that record itself and collide with the one the order says a human creates.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "olivares-docs-preprod",
  "compatibility_date": "2026-08-23",

  // ⛔ PREPROD HAS CODE IN ITS RESPONSE PATH AND PRODUCTION DOES NOT. That asymmetry is the
  // whole point of this file: preprod would serve a complete, crawlable copy of the
  // documentation on a public hostname, and production already sets its own canonical, so the
  // DUPLICATE is what carries the risk. `preprod-worker.ts` adds one header,
  // `X-Robots-Tag: noindex, nofollow`, and passes the body straight through.
  //
  // It could not be done in `wrangler.jsonc` — a pure-assets Worker has nowhere to set a
  // response header — and it must NOT be done in `public/_headers`, which is part of the build
  // and ships to PRODUCTION: noindex there would deindex docs.olivares.ai.
  "main": "preprod-worker.ts",

  // Identical to production on purpose: preprod that differs from production in how it SERVES is
  // not preprod, it is a third site. Only the name and the route differ.
  "assets": {
    "directory": "./dist",
    // `preprod-worker.ts` fetches from this binding after adding the preprod-only response
    // header. Without the explicit binding `env.ASSETS` does not exist at runtime.
    "binding": "ASSETS",
    // Cloudflare serves matching static assets before Worker code by default. That would bypass
    // the noindex header on every real page, so every request must enter the Worker first.
    // Primary source: https://developers.cloudflare.com/workers/static-assets/binding/#run_worker_first
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  "observability": { "enabled": true },

  "routes": [{ "pattern": "docs-preprod.olivaresai.dev/*", "zone_name": "olivaresai.dev" }]
}
