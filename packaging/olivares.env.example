#
# Operator overrides for the systemd service (/usr/lib/systemd/system/olivares.service).
# This file is marked config|noreplace, so package upgrades never clobber your edits.
#
# RECOMMENDED: generate this file instead of editing it by hand. The guided installer
# picks a profile, asks only what it needs, validates every value and keeps secrets
# out of this file (referenced as file:<path>):
#
#   sudo olivares setup                 # interactive (eval | single-node-prod | postgres-prod | k8s)
#   sudo olivares config generate …     # non-interactive / scriptable twin
#   olivares db init / olivares db check  # provision + verify the Postgres roles first
#
# (setup overwrites this file with --force and backs the old one up to .bak.)
#
# OLIVARES_EXTRA_ARGS is appended verbatim to `olivares serve`. Use it to widen the
# listen address, switch to Postgres, pin a TLS cert, set a data-residency region, etc.
# The defaults baked into the unit are loopback-only with a self-signed first-boot cert.
#
# Examples (uncomment + edit):
#
#   # Expose on all interfaces (front it with your own TLS-terminating reverse proxy):
#   OLIVARES_EXTRA_ARGS=--listen=0.0.0.0:8443 --grpc-listen=0.0.0.0:8444
#
#   # Bring your own TLS material instead of the self-signed first-boot cert:
#   OLIVARES_EXTRA_ARGS=--tls-cert=/etc/olivares/tls.crt --tls-key=/etc/olivares/tls.key
#
#   # Multi-tenant Postgres with row-level security (see deploy/postgres/01-app-role.sql):
#   OLIVARES_EXTRA_ARGS=--engine=postgres --dsn=postgres://olivares@localhost/olivares?sslmode=require
#
OLIVARES_EXTRA_ARGS=
