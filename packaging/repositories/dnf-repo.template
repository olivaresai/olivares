#
# DNF repository file for the public rpm-md repository, for DNF 4 (AlmaLinux 10,
# RHEL 10) and DNF5 (Fedora 41 and later).
# DNF 4 has no pkg_gpgcheck: it checks package signatures only with gpgcheck, which
# defaults to false. DNF5 reads pkg_gpgcheck and, under gpgcheck_policy=legacy (its
# default), expands gpgcheck=1 to pkg_gpgcheck=1 only, so repo_gpgcheck is set on its
# own. Both package lines say the same thing.
# https://dnf.readthedocs.io/en/latest/conf_ref.html (gpgcheck, repo_gpgcheck) and
# https://dnf5.readthedocs.io/en/latest/dnf5.conf.5.html (pkg_gpgcheck, gpgcheck_policy),
# retrieved 2026-10-17.
# The key is always a file:// path, never an address the repository answers: dnf would import
# whatever key that address serves, with no prompt under -y. The clean-client tests render this
# with a key file they pin. The olivares.repo a host downloads names
# /etc/pki/rpm-gpg/RPM-GPG-KEY-olivares-package-repository: the install guide stores the key
# there from https://packages.olivares.ai/olivares-packages.asc and prints its fingerprint to
# compare, so the host trusts the address once, on first use, and not again at every refresh.
[{{REPO_ID}}]
name={{REPO_NAME}}
baseurl={{BASEURL}}
enabled=1
gpgcheck=1
pkg_gpgcheck=1
repo_gpgcheck=1
gpgkey={{GPGKEY}}
metadata_expire=0
type=rpm-md
