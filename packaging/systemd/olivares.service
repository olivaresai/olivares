[Unit]
Description=Olivares AI — self-hosted engine for enterprise AI
Documentation=https://github.com/olivaresai/olivares
After=network-online.target
Wants=network-online.target
# A start that keeps failing within seconds stops after five tries in two minutes instead
# of looping every RestartSec forever (a slower retry, waiting for a database, goes on);
# after the cause is fixed, `systemctl reset-failed olivares` clears the count.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=olivares
Group=olivares
EnvironmentFile=-/etc/olivares/olivares.env
# --listen=:8443 is the dual-stack wildcard: the console accepts connections from the
# network on every address of this host, IPv4 and, where the kernel has IPv6, IPv6 too.
# That is what a server is for. (The bind is written `:8443` and not as a literal IPv4
# wildcard on purpose: the literal binds IPv4 ONLY, and check-service-install.sh
# rejects it in this directory for that reason.)
# TLS is on with a self-signed first-boot certificate and there are no default
# credentials. To restrict the engine to this host, set OLIVARES_EXTRA_ARGS in the
# environment file to "--listen=127.0.0.1:8443 --grpc-listen=127.0.0.1:8444" — the
# later flag on the command line wins — or edit this line with a drop-in override.
ExecStart=/usr/bin/olivares serve --data-dir=/var/lib/olivares --listen=:8443 --grpc-listen=:8444 --checkpoint-interval=1h $OLIVARES_EXTRA_ARGS
# A rollback that lost power mid-restore leaves the data volume half-restored and its marker in the snapshot directory.
# The marker blocks the start, and exit 1 skips the unit without failing it; the rollback run again finishes the
# restore and removes the marker. The + runs the test as root: that directory is root-only.
ExecCondition=+/usr/bin/test ! -e /var/lib/olivares-snapshots/rollback-in-progress
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
# Exit 15 (`olivares help exit-codes`): the engine refused a configuration or a store
# that only an operator can change, so a restart would fail the same way.
RestartPreventExitStatus=15
# A stop or restart signals the engine alone. It stops its sessions itself, recording
# the engine stop its next start resumes them from; systemd then ends what is left.
KillMode=mixed
NoNewPrivileges=true
# Keep OS configuration read-only while allowing chosen folders. Session and
# MCP children get the product's per-folder Landlock policy, not a unit-wide
# home/tmp mask that hides directories the operator selected.
ProtectSystem=full
ProtectHome=false
PrivateTmp=false
PrivateDevices=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
# Record-bound sessions run in their own user and network namespace (loopback
# only, egress through the per-session proxy), and a writable workspace's session
# helper in its own mount namespace, where it bind-mounts the workspace's git
# hooks and configuration read-only; every other namespace type is denied.
RestrictNamespaces=user net mnt
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# Node/V8 agent and MCP runtimes require executable JIT memory.
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
# The session/MCP launcher applies Landlock before executing each child.
SystemCallFilter=@system-service landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallFilter=~@privileged @resources
# The session network helper uses capset for its namespace-local capabilities
# (loopback setup), then drops them all before the tool runs. The engine itself
# keeps no host capability (CapabilityBoundingSet= below).
SystemCallFilter=capset
# The session helper's read-only bind mounts of a workspace's git hooks and
# configuration, and the empty filesystem it puts over the runtime directory of this
# user (where its user manager keeps its bus and private socket), happen inside its own mount namespace,
# where it holds only namespace-local capability. The engine keeps no host capability,
# so a mount outside that namespace still fails.
SystemCallFilter=mount
# The session helper raises each tool's nice value (+10) before it executes the
# tool. setpriority is in @resources; raising one's own nice value needs no
# privilege, and lowering it needs CAP_SYS_NICE, which the bounding set below
# never grants.
SystemCallFilter=setpriority
StateDirectory=olivares
StateDirectoryMode=0750
ReadWritePaths=/var/lib/olivares
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=multi-user.target
