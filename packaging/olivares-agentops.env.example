#
# Operate-Claude-Code runtime config for the native co-deployment.
# Installed at /etc/olivares/agentops.env and read by the agentops systemd drop-in
# (packaging/systemd/olivares.service.d/agentops.conf). Config|noreplace: edits
# survive upgrades. These are process-env values the engine reads at boot to wire the
# session runtime (cmd/olivares/sessionruntime.go) — NOT extra `serve` flags.

# --- inference credential (DENY-CLOSED) -------------------------------------------
# The governed stream-json transport needs a SHORT-LIVED bearer token. The engine
# reads this file per launch, injects it as ANTHROPIC_AUTH_TOKEN in memory, and
# discards it (only the non-sensitive credential_id is ever persisted). UNSET ⇒
# stream-json launches fail CLOSED (no static key, by design). Point it at the file
# your WIF/SPIFFE/OIDC refresher rotates; the live in-process exchange wires it.
OLIVARES_SESSION_RUNTIME_TOKEN_FILE=/var/lib/olivares/run/session-token

# Asserted lifetime of a freshly-read token — match your refresher's cadence so a
# stale token is re-read before it expires (default 15m).
OLIVARES_SESSION_RUNTIME_TOKEN_TTL=15m

# --- optional: govern the session's inference in-band -----------------------------
# Route the operated session's API calls through Olivares' own gateway (sets
# ANTHROPIC_BASE_URL for the child) so they are PEP/budget/model-governed in-band.
# Leave unset for v1 (direct to the provider).
# OLIVARES_SESSION_RUNTIME_BASE_URL=https://127.0.0.1:8443/v1

# --- optional: BYO claude ---------------------------------------------------------
# Default is `claude` on the service PATH. Set an absolute path to use a claude you
# installed elsewhere (e.g. the operator's own native install, or OLIVARES_CLAUDE_INSTALL=byo).
# OLIVARES_SESSION_RUNTIME_CLAUDE_BIN=/usr/bin/claude

# --- governed tool-calls (PEP) ----------------------------------------------------
# The DIFFERENTIATOR: every tool-call a governed session makes passes the in-line PEP.
# Two halves, both wired here + by `olivares agent managed-settings`:
#   (1) STATIC, per-host:  the managed-settings.json with the PreToolUse hook
#       (allowManagedHooksOnly) at /etc/claude-code/managed-settings.json — render it with
#       `olivares agent managed-settings --out /etc/claude-code/managed-settings.json`.
#   (2) PER-SESSION, here: the loopback PEP endpoint the hook reaches. UNSET ⇒ the
#       managed hook is DENY-CLOSED and every tool-call is denied (the session can think
#       but not act). It must match the hooks-PEP listen addr (OLIVARES_HOOK_PEP_CONFIG).
# OLIVARES_SESSION_PEP_URL=http://127.0.0.1:8447/
# A rotated per-session PEP bearer the engine authenticator resolves to the session's
# principal (your identity broker writes it 0600, owned by olivares). UNSET ⇒ the hook
# authenticates by agent hint only; a require_firm_identity tenant then denies.
# OLIVARES_SESSION_PEP_TOKEN_FILE=/var/lib/olivares/run/pep-token

# --- active kill-switch over running sessions -------------------------------------
# How often the runtime re-checks live sessions against the estate kill-switch and
# TERMINATES any now under an emergency stop (the "para" half — Olivares owns the
# process, so a stop stops running work, not only blocks new launches). "" ⇒ 15s;
# "0" disables active termination (block-on-launch only; a stopped session is still
# neutralized at the tool boundary by the PEP).
# OLIVARES_SESSION_KILLSWITCH_SWEEP=15s

# --- launch-control availability posture -----------------------------------------
# OLIVARES_SESSION_BUDGET_AVAILABILITY and OLIVARES_SESSION_CONTEXT_AVAILABILITY
# accept fail-open or fail-closed and apply only when the corresponding launch control
# cannot be read. Unset defaults to fail-closed in enterprise builds and fail-open in
# community builds. A definitive budget cap or context-policy forbid always denies,
# regardless of this posture; approval and privileged recording remain deny-closed and
# are not configurable.
# OLIVARES_SESSION_BUDGET_AVAILABILITY=fail-closed
# OLIVARES_SESSION_CONTEXT_AVAILABILITY=fail-closed

# -----------------------------------------------------------------------------------
# Token refresher (EXAMPLE — not shipped as a working unit; the live exchange wires it).
# A minimal pattern: a systemd timer that mints a short-lived bearer and writes it to
# OLIVARES_SESSION_RUNTIME_TOKEN_FILE with 0600, owned by the olivares user. Example:
#
#   # /etc/systemd/system/olivares-session-token.service  (Type=oneshot, User=olivares)
#   ExecStart=/usr/local/bin/olivares-session-token-refresh   # YOUR WIF/OIDC exchange
#   # /etc/systemd/system/olivares-session-token.timer        (OnUnitActiveSec=10m)
#
# The refresh script is yours (it talks to your IdP/SPIFFE/cloud-WIF and has no static
# secret). For EVALUATION only, you may write a static bearer to the token file by hand
# — clearly NOT for production (no rotation, a long-lived secret on disk).
