[Unit]
Description=Olivares AI — self-hosted engine for enterprise AI
Documentation=https://github.com/olivaresai/olivares
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
@USER_LINE@
@GROUP_LINE@
EnvironmentFile=-@CONFIG@
# --listen=:8443 is the dual-stack wildcard: the console accepts connections from the
# network on every address of this host, IPv4 and, where the kernel has IPv6, IPv6 too.
# That is what a server is for. (The bind is written `:8443` and not as a literal IPv4
# wildcard on purpose: the literal binds IPv4 ONLY, and check-service-install.sh
# rejects it in this directory for that reason.)
# TLS is on with a self-signed first-boot certificate and there are no default
# credentials. To restrict the engine to this host, set OLIVARES_EXTRA_ARGS in the
# environment file to "--listen=127.0.0.1:8443 --grpc-listen=127.0.0.1:8444" — the
# later flag on the command line wins — or edit this line with a drop-in override.
ExecStart=@BINARY@ serve --data-dir=@DATA_DIR@ --listen=:8443 --grpc-listen=:8444 --checkpoint-interval=1h $OLIVARES_EXTRA_ARGS
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
# Keep OS configuration read-only while allowing chosen folders. Session and
# MCP children get the product's per-folder Landlock policy, not a unit-wide
# home/tmp mask that hides directories the operator selected.
ProtectSystem=full
ProtectHome=false
PrivateTmp=false
PrivateDevices=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
# Record-bound sessions run in their own user and network namespace (loopback
# only, egress through the per-session proxy); every other namespace type is denied.
RestrictNamespaces=user net
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# Node/V8 agent and MCP runtimes require executable JIT memory.
MemoryDenyWriteExecute=false
SystemCallArchitectures=native
# The session/MCP launcher applies Landlock before executing each child.
SystemCallFilter=@system-service landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallFilter=~@privileged @resources
# The session network helper uses capset for its namespace-local capabilities
# (loopback setup), then drops them all before the tool runs. The engine itself
# keeps no host capability (CapabilityBoundingSet= below).
SystemCallFilter=capset
@STATE_DIRECTORY_LINE@
ReadWritePaths=@DATA_DIR@
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=@WANTED_BY@
