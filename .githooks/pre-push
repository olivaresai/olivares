# ⛔ THE CGROUP FIRST, AND /proc/meminfo ONLY AS A FALLBACK. This read /proc/meminfo alone until
# 2026-08-10, and /proc/meminfo IS THE HOST: inside a container it reports the machine's free
# memory, not the share this container may use. Measured that day, minutes apart: host
# MemAvailable 13.8 GiB while the container had 0.72 GiB free of its 9 GiB cap. With the 6 GiB
# threshold the check saw 13.8, concluded there was room, and ran the FULL PARALLEL gate — which
# is how a container at 99 percent of its limit came to launch a -race suite whose binaries are
# 500 to 750 MB each. The valve built to prevent exactly that had never once fired.
#
# It is the same class as measuring a gate in the stale shared clone, or reading a wrapper's CPU
# instead of the leaf's: an instrument pointed at the wrong subject answers confidently and wrong.
#
# What counts as available here is the cap minus what CANNOT be reclaimed — anon, shmem and slab.
# Not memory.max - memory.current: `current` counts page cache, which the kernel drops under
# pressure, so that subtraction reads 0.72 GiB on a healthy container and would degrade every
# single gate to serial. Over-degrading is not free either: it turns a 50 minute leg into hours.
mem_available_kib=
if [ -r /sys/fs/cgroup/memory.max ] && [ -r /sys/fs/cgroup/memory.stat ]; then
	mem_cg_max="$(cat /sys/fs/cgroup/memory.max 2>/dev/null || echo max)"
	if [ "$mem_cg_max" != "max" ] && [ -n "$mem_cg_max" ]; then
		mem_cg_hard=0
		while read -r mem_key mem_value _; do
			case "$mem_key" in
			anon | shmem | slab)
				mem_cg_hard=$((mem_cg_hard + mem_value))
				;;
			esac
		done </sys/fs/cgroup/memory.stat
		if [ "$mem_cg_hard" -gt 0 ] && [ "$mem_cg_max" -gt "$mem_cg_hard" ]; then
			mem_available_kib=$(((mem_cg_max - mem_cg_hard) / 1024))
			echo "pre-push: memory measured from the CGROUP (this container), not /proc/meminfo (the host)." >&2
		fi
	fi
fi
if [ -z "$mem_available_kib" ] && [ -r /proc/meminfo ]; then
	# No cgroup v2 limit: we are not capped, so the host figure IS the right subject.
	while read -r mem_key mem_value _; do
		if [ "$mem_key" = "MemAvailable:" ]; then
			mem_available_kib=$mem_value
			break
		fi
	done </proc/meminfo
fi

if [ -n "$mem_available_kib" ] &&
	[ "$mem_available_kib" -lt "$((10#$gate_mem_min_gib * 1024 * 1024))" ]; then
	echo "pre-push: MemAvailable=${mem_available_kib} KiB, threshold=${gate_mem_min_gib} GiB; running the test gate in degraded serial mode (same correctness, less memory)." >&2
	GOFLAGS="-p=1" GOMAXPROCS=2 task test
else
