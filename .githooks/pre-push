# lint:disk-headroom BEFORE everything, and it is one `df`. The eleven-module build once died
# with "no space left on device" and that reads as a COMPILER error: the machine, not the tree,
# was full. A gate that starts without headroom cannot distinguish "broken" from "could not
# look", so this answers first and refuses fast rather than half-way through a link.
# VA EL PRIMERO, y no por gusto: si el árbol está a medias, ningún veredicto de los que vienen
# detrás significa lo que dice. Medido el 2026-08-19 en el propio hub — un `git rebase` aplanó un
# commit de merge, se detuvo en conflicto, y la cadena de publicación corrió tres gates de
# contenido que PASARON sobre el árbol parcial y empujó un HEAD detached a `main`. «Gates OK» era
# cierto sobre un árbol que no era el que el integrador creía publicar. Cuesta milisegundos: mira
# .git, no el árbol.
# --- EL CORCHETE DEL ARBOL: un gate que MODIFICA el arbol mientras lo comprueba ------------
# `scripts/check-tree-untouched.sh` se construyo el 2026-08-19 exactamente para esto, con sus dos
# modos (`--snapshot` antes, `--compare` despues) y su bateria. **Y la unica llamada de todo el
# arbol era su propio `--selftest`**: `lint:tree-untouched` verifica que la herramienta funciona
# y nadie la usa para lo que existe. Su propia descripcion documenta el hueco —«nada en el hook
# ni en mainline-ci miraba el arbol despues»— y ese hueco seguia abierto porque la herramienta
# que lo cierra no estaba cableada.
#
# Medido el 2026-08-20 en este worktree: `--snapshot` y `--compare` cuestan **0 s**, `--compare`
# sobre un arbol intacto da 0 y **da 1 en cuanto se muta un fichero**. No hay razon de coste.
#
# ⛔ Y VA COMPUESTO, NO EN UN `trap` PROPIO. La primera version instalaba
# `trap 'olivares_comparar_arbol' EXIT` aqui y decia «cubre TODAS las salidas». **Era falso en los
# dos sentidos**, y lo midio el contraste Codex `sol max` del 2026-08-20 (CRITICA, VERIFICADO):
#
#   · SUSTITUIA al trap de la linea 240, que recoge `push_refs_file` — es decir, mi guarda nueva
#     reabria la fuga de /tmp que ese trap existe para cerrar (47.520 ficheros medidos en su dia).
#   · y el carril completo la SUSTITUIA a ella con `prepush_cleanup`, asi que el control NO CORRIA
#     en el unico carril que construye y prueba, y encima dejaba su propia foto sin borrar.
#
# Lo peor no es el fallo: es que lo anadi doce lineas despues de un comentario que advierte
# LITERALMENTE de esto — «un segundo `trap ... EXIT` SUSTITUYE al primero, no se suma». Leerlo y
# repetirlo igual es la razon de que esto vaya ahora en una funcion que los dos traps llaman.
# ⛔ EL `mktemp` VA DENTRO DE LA GUARDA, Y NO ES ESTILO. Hasta el 2026-08-22 estaba ENCIMA del
# `if`, asi que el fichero se creaba SIEMPRE y la guarda decidia DESPUES si llegaba a usarse.
# `scripts/check-tree-untouched.sh` entro el 2026-08-19, y esta guarda mira el arbol de LA RAMA QUE
# SE EMPUJA, no el del hook: el 2026-08-22 las CUARENTA ramas abiertas eran anteriores, o sea que
# el `-x` fallaba en todas. El `if` cae entonces sin `else` que recoja —el `else` de abajo solo
# cubre «la foto fallo»— y el trap activo en este punto es el de la linea 240, que borra el fichero
# de refs y NADA MAS. Un fichero vacio por push y por carril: 9.691 medidos en /tmp, **todos de 0
# bytes**, que es la firma de esto y no de otra cosa (una foto de verdad pesa).
# Y hay una segunda salida por la misma puerta: el `exit 0` de la linea ~1210 ocurre antes de que
# `trap prepush_cleanup EXIT` se instale, asi que sin la guarda tampoco recogia la foto.
# Lo cubre `scripts/test-prepush-treesnap.sh` con control negativo: restaurar esta forma vieja
# vuelve a fugar y el test lo dice.
OLIVARES_TREE_SNAP=""
if [ -x scripts/check-tree-untouched.sh ]; then
	OLIVARES_TREE_SNAP="$(mktemp "${TMPDIR:-/tmp}/prepush-treesnap.XXXXXX" 2>/dev/null || true)"
fi
if [ -n "$OLIVARES_TREE_SNAP" ]; then
	if bash scripts/check-tree-untouched.sh --snapshot "$OLIVARES_TREE_SNAP" >/dev/null 2>&1; then
		# Se llama desde CADA trap EXIT del hook. Idempotente: se desarma sola borrando la foto,
		# asi que si dos traps la invocan, la segunda no dice nada.
		olivares_comparar_arbol() {
			[ -n "${OLIVARES_TREE_SNAP:-}" ] && [ -r "${OLIVARES_TREE_SNAP:-}" ] || return 0
			# ⛔ LA ASIGNACION VA DENTRO DEL `if`, Y NO ES ESTILO. Con `salida=$(...)` en su
			# propia linea, `set -euo pipefail` mata la funcion en cuanto `--compare` devuelve 1
			# — es decir, EXACTAMENTE en el unico caso para el que existe esta guarda. Medido con
			# un arnes de seis casos: el arbol mutado salia rc 1 en vez de conservar el veredicto,
			# NO imprimia el aviso y fugaba los dos temporales. Es la misma forma que corregi en
			# `check-holds.sh` esta misma noche, repetida doce lineas despues.
			local salida
			if salida=$(bash scripts/check-tree-untouched.sh --compare "$OLIVARES_TREE_SNAP" 2>&1); then
				: # el arbol esta como estaba; en silencio
			else
				printf '%s\n' "$salida" >&2
				echo "pre-push: ⛔ UN GATE MODIFICO EL ARBOL DE TRABAJO mientras lo comprobaba." >&2
				echo "pre-push:   Lo de arriba es la diferencia. No es tuyo: lo dejo un gate de esta corrida," >&2
				echo "pre-push:   y en un clon compartido lo recoge el \`git add\` del siguiente carril." >&2
			fi
			rm -f -- "$OLIVARES_TREE_SNAP"
			OLIVARES_TREE_SNAP=""
		}
		# Hace las DOS cosas a proposito, igual que `prepush_cleanup` mas abajo y por la misma
		# razon: instalar aqui la comparacion a secas descartaria el trap que recoge el fichero
		# de refs, y devolveria la fuga de /tmp.
		olivares_salida_rapida() {
			rc_previo=$?
			olivares_comparar_arbol
			rm -f "${push_refs_file:-}"
			return $rc_previo
		}
		trap olivares_salida_rapida EXIT
	else
		rm -f -- "$OLIVARES_TREE_SNAP"
	fi
fi

