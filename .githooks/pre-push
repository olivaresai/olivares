# ---------------------------------------------------------------------------
# Host-wide heavy-gate mutex over an atomic remote ref.
#
# Guarded below on the generated public-export marker: in a curated public tree
# (marker present) this section is a no-op — a contributor's clone neither expects
# refs/gate-locks/* nor wants a hook creating refs on its origin.
#
# Rationale: several checkouts of this repository can run this heavy gate
# concurrently on one machine; their filesystems are separate, so a local flock
# cannot serialize them. The one shared, atomic medium every checkout already
# trusts is origin itself: creating a ref fails if it exists, and
# `--force-with-lease=<ref>:` (empty expected value) makes creation atomic — no
# check-then-push window.
#
# Semantics:
#   * the lock commit is a FRESH commit-tree of HEAD's tree, so its committer
#     date is the acquisition time — the ref's age IS the lock's age;
#   * a holder older than 3h is presumed dead and stolen, loudly;
#   * we WAIT (60s poll, 3h cap) rather than fail: the gate serializes work,
#     it does not reject it;
#   * if origin is unreachable the gate runs WITHOUT the lock, loudly — the
#     gate must never depend on the network to run;
#   * refs/gate-locks/* is not a branch: it triggers no workflows and shows in
#     no PR. This mutex covers concurrent local lanes, which is where the
#     collisions actually happen.
GATE_LOCK_REF="refs/gate-locks/heavy"
# ⛔ D-1 / L-02 CERRADO el 2026-08-16 por la SEGUNDA vía que la propia nota autoriza: «WAIT >
# STALE fijado y declarado». El defecto era de ORDEN, no de mecanismo: con WAIT == STALE == 10800
# el carril se rendía EXACTAMENTE en el umbral, y el robo exige `age > STALE`, así que la
# recuperación ANUNCIADA de un titular indeterminable era INALCANZABLE — un candado abandonado en
# otro host no se recuperaba nunca. Un mecanismo cuyo comentario promete algo que no puede ocurrir
# es peor que no tenerlo: se confía en él.
#
# Ahora STALE es una variable con nombre y WAIT se DERIVA de ella con margen, así que el robo
# siempre se evalúa ANTES de rendirse. Si alguien fija WAIT a mano por debajo de STALE, se corrige
# y se DICE, en vez de dejar la promesa rota en silencio.
GATE_LOCK_STALE_SECS="${OLIVARES_GATE_LOCK_STALE_SECS:-10800}"
GATE_LOCK_WAIT_SECS="${OLIVARES_GATE_LOCK_WAIT_SECS:-$((GATE_LOCK_STALE_SECS + 1800))}"
if [ "$GATE_LOCK_WAIT_SECS" -le "$GATE_LOCK_STALE_SECS" ]; then
	echo "pre-push: WAIT (${GATE_LOCK_WAIT_SECS}s) <= STALE (${GATE_LOCK_STALE_SECS}s): la recuperacion" >&2
	echo "pre-push: de un candado abandonado seria inalcanzable. Elevando WAIT a $((GATE_LOCK_STALE_SECS + 1800))s." >&2
	GATE_LOCK_WAIT_SECS=$((GATE_LOCK_STALE_SECS + 1800))
fi
gate_lock_held=0

gate_lock_holder_age() {
	# Prints the age in seconds of the current lock commit, or nothing if unreadable.
	local sha
	sha="$(git ls-remote origin "$GATE_LOCK_REF" 2>/dev/null | cut -f1)" || return 0
	[ -n "$sha" ] || return 0
	git fetch -q origin "$GATE_LOCK_REF" 2>/dev/null || return 0
	local when now
	when="$(git show -s --format=%ct "$sha" 2>/dev/null)" || return 0
	now="$(date +%s)"
	[ -n "$when" ] && echo $((now - when))
}

# EVERY lock push carries --no-verify: a push of the lock ref would otherwise
# fire THIS hook, which runs the full gate before pushing — a 2h acquisition at
# best, a deadlock in spirit. Measured on 2026-07-30: the first live probe of
# the lock started the whole gate. The lock is signalling, not content.
release_gate_lock() {
	if [ "$gate_lock_held" = "1" ]; then
		git push --no-verify -q origin ":${GATE_LOCK_REF}" 2>/dev/null || true
		gate_lock_held=0
	fi
}
# Hace las DOS cosas a proposito: instalar aqui `release_gate_lock` a secas descartaria el
# trap que recoge el fichero de refs, y volveria la fuga de /tmp.
prepush_cleanup() {
	rc_previo=$?
	release_gate_lock
	# TRES cosas: sin esta linea el carril completo —el unico que construye y prueba— se quedaba
	# sin el control del arbol y dejaba su foto en /tmp. Medido por el contraste del 2026-08-20.
	command -v olivares_comparar_arbol >/dev/null 2>&1 && olivares_comparar_arbol
	rm -f "${push_refs_file:-}"
	return $rc_previo
}
trap prepush_cleanup EXIT

acquire_gate_lock() {
	local waited=0 lock_commit
	while :; do
		lock_commit="$(git commit-tree "HEAD^{tree}" -m "gate-lock $(hostname) pid=$$ $(date -u +%FT%TZ)" 2>/dev/null)" || {
			echo "pre-push: could not create a lock commit; proceeding WITHOUT the host lock." >&2
			return 0
		}
		if git push --no-verify -q origin "${lock_commit}:${GATE_LOCK_REF}" --force-with-lease="${GATE_LOCK_REF}:" 2>/dev/null; then
			gate_lock_held=1
			return 0
		fi
		# Push refused: either the ref exists (someone holds it) or origin is down.
		if ! git ls-remote origin "$GATE_LOCK_REF" >/dev/null 2>&1; then
			echo "pre-push: origin unreachable; proceeding WITHOUT the host lock (the gate must not depend on the network)." >&2
			return 0
		fi
		local age
		age="$(gate_lock_holder_age)"
		if [ -n "$age" ] && [ "$age" -gt "$GATE_LOCK_STALE_SECS" ]; then
			echo "pre-push: gate lock is ${age}s old (>${GATE_LOCK_STALE_SECS}s); presuming the holder dead and STEALING it." >&2
			if git push --no-verify -q -f origin "${lock_commit}:${GATE_LOCK_REF}" 2>/dev/null; then
				gate_lock_held=1
				return 0
			fi
		fi
		if [ "$waited" -ge "$GATE_LOCK_WAIT_SECS" ]; then
			echo "pre-push: waited ${waited}s for the heavy-gate lock; giving up. Another lane is running its gate — retry when it finishes, or raise OLIVARES_GATE_LOCK_WAIT_SECS." >&2
			exit 1
		fi
		[ $((waited % 600)) -eq 0 ] && echo "pre-push: heavy-gate lock held by another lane (age ${age:-?}s); waiting (${waited}/${GATE_LOCK_WAIT_SECS}s)..." >&2
		sleep 60
		waited=$((waited + 60))
	done
}
# HUB MARKER GUARD (see the section header): only the maintainer hub — the one
# tree that carries scripts/export-public.sh — acquires the lock. Everywhere
# else this is a no-op, so a public clone never creates refs on its origin.
if [ ! -f .olivares-public-export ]; then # hub only: a public clone must never push lock refs to its origin
