#
# pre-push — the checks that measure a change, run on what the push changes, in under two
# minutes. Installed by `task setup` (git config core.hooksPath .githooks). It saves a round
# trip and is not a security boundary: CI runs these checks again. Bypass with
# `git push --no-verify` and say so in the PR.
#
# For each pushed ref, over the commits the remote does not have yet:
#   gitleaks   the pushed commits                      (.gitleaks.toml)
#   SPDX       the changed files                       (scripts/check-spdx.sh)
#   bundle     no generated console output in the push (scripts/check-web-bundle-freshness.sh)
#   boundary   when Go code or modules changed         (task lint:boundary)
#   go vet     the touched packages, tests included    (scripts/changed-go-packages.sh)
#   identity   the pushed commits' ident and trailers  (task lint:commit-identity, hub-only:
#              the leg answers NOT APPLICABLE in the public tree)
# A pushed commit other than a clean checked-out HEAD (no edits, no untracked files) is checked
# in a temporary checkout.
# The checks are this checkout's scripts and gitleaks config, run on the pushed tree, so a ref
# whose tree lacks or predates them (a status board, an old branch) is checked all the same.
# The boundary task is the exception: it is the pushed tree's own, and runs only when that
# tree changed Go code.
set -euo pipefail
EMPTY_TREE=4b825dc642cb6eb9a060e54bf8d69288fbee4904 # git's empty tree: a base when no remote holds any of the push
PRE_PUSH_TREE=""
PRE_PUSH_REFS=""

# One trap for everything the run can leave behind: a temporary checkout, and the copy of the
# pushed refs the bundle check reads. A second `trap … EXIT` would replace this one, so the
# worktree path travels in PRE_PUSH_TREE instead of a trap of its own. Every step survives the
# one before it failing, and a signal exits through the trap instead of around it.
cleanup() {
	if [ -n "$PRE_PUSH_TREE" ]; then
		git worktree remove --force "$PRE_PUSH_TREE" >/dev/null 2>&1 || :
		rm -rf "$PRE_PUSH_TREE" || :
	fi
	[ -z "$PRE_PUSH_REFS" ] || rm -f "$PRE_PUSH_REFS" || :
}

main() {
	cd "$(git rev-parse --show-toplevel)"
	TOP="$PWD"
	# git exports GIT_DIR to a hook run from a linked worktree; every check reads the tree it runs in.
	. scripts/lib/git-env.sh
	local remote=$1 url=${2:-} zero=0000000000000000000000000000000000000000
	local local_ref local_sha remote_ref remote_sha base boundary edges status remotes known=()
	# The pushed refs as git gave them, saved because the loop below consumes stdin and the
	# bundle check reads the protocol whole.
	PRE_PUSH_REFS="$(mktemp "${TMPDIR:-/tmp}/pre-push.refs.XXXXXX")"
	trap cleanup EXIT
	trap 'exit 129' HUP
	trap 'exit 130' INT
	trap 'exit 143' TERM
	if ! cat >"$PRE_PUSH_REFS"; then
		echo "pre-push: could not read the pushed refs from stdin — refusing. A hook that did" >&2
		echo "pre-push: not receive the refs has checked nothing." >&2
		exit 1
	fi
	# Generated console output belongs to the build, never to a source push. Reads every pushed
	# range from the protocol itself and costs ~0 s.
	OLIVARES_PUSH_REFS_FILE="$PRE_PUSH_REFS" bash "$TOP/scripts/check-web-bundle-freshness.sh"
	# What the destination already holds: its own remote-tracking refs. A push to a URL with no
	# configured remote has none, so everything the push brings is checked.
	remotes="$(git remote)"
	if grep -Fxq -- "$remote" <<<"$remotes"; then known=(--remotes="$remote"); fi
	while read -r local_ref local_sha remote_ref remote_sha <&3; do
		[ "$local_sha" = "$zero" ] && continue # a deletion pushes no content
		# The commits the destination does not hold, diffed against the newest commit it does
		# hold (the empty tree if none), so a rebased or merged branch is checked for its own change.
		[ -n "$(git rev-list -1 "$local_sha" --not "${known[@]}")" ] || continue
		boundary="$(git rev-list --boundary "$local_sha" --not "${known[@]}")"
		edges="$(sed -n 's/^-//p' <<<"$boundary")"
		base="$EMPTY_TREE"
		# shellcheck disable=SC2086 # one commit per word
		[ -z "$edges" ] || base="$(git rev-list -1 --no-walk $edges)"
		status="$(git status --porcelain)"
		if [ "$(git rev-parse HEAD)" = "$local_sha" ] && [ -z "$status" ]; then
			check "$base" "$local_sha"
		else
			check_in_checkout "$base" "$local_sha"
		fi
	done 3<"$PRE_PUSH_REFS"
	# The identity guard judges the whole push — every introduced commit's author, committer
	# and trailers, and pushed annotated tags — from the protocol, so it runs once, after the
	# per-ref checks. The 2026-10-05 rewrite of this hook dropped the guard's only caller,
	# unnamed, and a commit with a private e-mail address reached main the same week. The
	# protocol file and the push's remote name and URL are what the guard reads: without them
	# it would guess a range, and against the wrong remote its exclusion base measures the
	# wrong repository. Any verdict but CLEAN refuses the push (BROKEN names the offender;
	# UNVERIFIED is the fail-closed answer, never a vacuous pass).
	OLIVARES_PUSH_REFS_FILE="$PRE_PUSH_REFS" OLIVARES_PUSH_REMOTE_NAME="$remote" \
	OLIVARES_PUSH_REMOTE_URL="$url" task lint:commit-identity
}

# The pushed commit is not this clean checkout (another ref, edits or untracked files on top),
# so its own tree is checked in a temporary checkout. On failure the EXIT trap in main removes
# the worktree; on success it is removed here.
check_in_checkout() {
	PRE_PUSH_TREE="$(mktemp -d "${TMPDIR:-/tmp}/pre-push.XXXXXX")"
	git worktree add --quiet --detach "$PRE_PUSH_TREE" "$2"
	(
		cd "$PRE_PUSH_TREE"
		check "$1" "$2"
	)
	git worktree remove --force "$PRE_PUSH_TREE"
	PRE_PUSH_TREE=""
}

check() {
	local base=$1 head=$2 changed touched files pkgs
	local range="$base..$head"
	[ "$base" != "$EMPTY_TREE" ] || range="$head"
	gitleaks git --no-banner --redact --config "$TOP/.gitleaks.toml" --log-opts="$range" .
	# Captured first so a failing command fails the push (a process substitution would not).
	# Deleted paths stay in: a deletion can break the packages that used what it removed.
	changed="$(git -c core.quotePath=false diff --no-renames --name-only "$base" "$head")"
	[ -n "$changed" ] || return 0
	mapfile -t files <<<"$changed"
	sh "$TOP/scripts/check-spdx.sh" --files "${files[@]}"
	if grep -Eq '\.go$|(^|/)go\.(mod|sum|work)$' <<<"$changed"; then
		task lint:boundary
	fi
	touched="$(bash "$TOP/scripts/changed-go-packages.sh" "$base" "$head")"
	[ -n "$touched" ] || return 0
	mapfile -t pkgs <<<"$touched"
	go vet "${pkgs[@]}"
}

# Parsed whole before it runs, so a checkout during the push cannot change what executes.
main "$@"
exit
