// Go multi-module workspace for the Olivares AI control plane.
//
// web/ is intentionally absent: it is a React/TS/Vite project, not a Go module.
// Its built assets are embedded into ./core via go:embed (see
// core/internal/webui/embed.go). The single static `olivares` binary is
// built from ./core.
//
go 1.26.9

toolchain go1.26.9

use (
	./clients/generator
	./clients/go
	./cmd/olivares
	./connectors
	./core
	./modules
	./sdk
	./sdk/plugin
	./sdk/scaffold
)
