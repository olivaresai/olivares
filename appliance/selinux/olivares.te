allow olivares_firstboot_t systemd_networkd_unit_file_t:service status;

# FBOOT-92: GetUnit checks status on networkd.socket's file label (Fedora 44.10 systemd.fc:30); never start or enable
allow olivares_firstboot_t systemd_unit_file_t:service status;

########################################
#
# The one Fedora interface call
#

# CLI-16: the operator's SSH login, root through sudo, runs olivares-appliance in olivares_cli_t: the one Fedora interface call, inside optional_policy; its rules are checked on the installed policy
optional_policy(`
	unconfined_run_to(olivares_cli_t, olivares_cli_exec_t)
')
