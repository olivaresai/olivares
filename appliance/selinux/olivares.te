# FBOOT-77: cloud-init reads the drop-in at later boots
allow cloud_init_t olivares_cloud_owner_t:file { getattr open read };

# FBOOT-78: follows /var/lib/cloud/instance to the instance directory (FBOOT-67 and -68 search and read cloud_var_lib_t)
