########################################
#
# Rules, one per row
#

# ---- PORTAL ----

# PORTAL-05: stdin/stdout/stderr (journal stream, passed socket or tty) are descriptors PID 1 opened; explicit so it holds with the Fedora boolean domain_fd_use off
allow olivares_portal_t init_t:fd use;

# ---- RCON ----

# RCON-05: stdin/stdout/stderr (journal stream, passed socket or tty) are descriptors PID 1 opened; explicit so it holds with the Fedora boolean domain_fd_use off
allow olivares_repair_console_t init_t:fd use;

# ---- HPWR ----

# HPWR-05: stdin/stdout/stderr (journal stream, passed socket or tty) are descriptors PID 1 opened; explicit so it holds with the Fedora boolean domain_fd_use off
allow olivares_helper_power_t init_t:fd use;

# ---- HBND ----

# HBND-05: stdin/stdout/stderr (journal stream, passed socket or tty) are descriptors PID 1 opened; explicit so it holds with the Fedora boolean domain_fd_use off
allow olivares_helper_bundle_t init_t:fd use;

# ---- SNAP ----

# SNAP-05: stdin/stdout/stderr (journal stream, passed socket or tty) are descriptors PID 1 opened; explicit so it holds with the Fedora boolean domain_fd_use off
allow olivares_snapshotcore_t init_t:fd use;

# ---- FBOOT ----

# FBOOT-05: stdin/stdout/stderr (journal stream, passed socket or tty) are descriptors PID 1 opened; explicit so it holds with the Fedora boolean domain_fd_use off
allow olivares_firstboot_t init_t:fd use;

# ---- PROD ----

# PROD-05: stdin/stdout/stderr (journal stream, passed socket or tty) are descriptors PID 1 opened; explicit so it holds with the Fedora boolean domain_fd_use off
allow olivares_t init_t:fd use;

# ---- PORTAL ----

# PORTAL-10: systemd labels a socket unit's listener with its service's domain (socket.c:1480-1500, service.c:5720); tcp 9443 alone is olivares_portal_port_t (semanage port -a; Fedora's pki_ca_port_t covers 9443-9447, corenetwork.te.in:290)
allow olivares_portal_t olivares_portal_port_t:tcp_socket name_bind;

# PORTAL-11: the bind to 127.0.0.1 is checked on the socket's domain; lo_node_t is an alias of node_t (corenetwork.te.in:439)
allow olivares_portal_t node_t:tcp_socket node_bind;

# PORTAL-12: serves TLS on the passed listener; reads SO_BINDTODEVICE back (getopt); Go sets TCP options on accepted connections (setopt)
allow olivares_portal_t self:tcp_socket { accept getattr getopt read setopt shutdown write };

# PORTAL-13: reaches /etc/olivares-portal
allow olivares_portal_t etc_t:dir search;

# PORTAL-14: custody check of the operator's TLS directory by lstat
allow olivares_portal_t olivares_portal_etc_t:dir { getattr search };

# PORTAL-15: reads the published selection; lstat of tls.crt
allow olivares_portal_t olivares_portal_etc_t:file { getattr open read };

# PORTAL-16: custody of tls.key is measured by lstat only; the key reaches the console as a credential, never by open
allow olivares_portal_t olivares_portal_key_t:file getattr;

# PORTAL-17: PID 1 reads the certificate for LoadCredential=
allow init_t olivares_portal_etc_t:file { getattr open read };

# PORTAL-18: PID 1 alone reads the operator's key for LoadCredential=
allow init_t olivares_portal_key_t:file { getattr open read };

# PORTAL-19: reaches /run/credentials/olivares-portal.service
allow olivares_portal_t var_run_t:dir search;

# PORTAL-20: the unit's credential directory, labeled by file context when systemd sets it up (exec-credential.c:974,1051)
allow olivares_portal_t olivares_portal_cred_t:dir { getattr open read search };

# PORTAL-21: reads the delivered tls.crt and tls.key copies
allow olivares_portal_t olivares_portal_cred_t:file { getattr open read };

# PORTAL-22: reaches the firewall owner's measurement
allow olivares_portal_t olivares_firewall_run_t:dir search;

# PORTAL-23: reads the firewall measurement of this boot
allow olivares_portal_t olivares_firewall_run_t:file { getattr open read };

# PORTAL-24: reaches /proc/sys
allow olivares_portal_t proc_t:dir search;

# PORTAL-25: reaches /proc/sys/kernel
allow olivares_portal_t sysctl_t:dir search;

# PORTAL-26: reads this boot's id
allow olivares_portal_t sysctl_kernel_t:file { getattr open read };

# PORTAL-27: PID 1 mounts the credential file system on the unit's credential directory (exec-credential.c:1040-1051)
allow init_t olivares_portal_cred_t:dir mounton;

# PORTAL-28: the inherited local listener and the connections it accepts, which carry its label: accept, the socket addresses, SO_PASSCRED, SO_PEERCRED and SO_PEERPIDFD, the TIOCINQ unread-byte ioctl (no allowxperm names this domain, so the ioctl permission is the whole check), recvmsg and write; no listen or bind
allow olivares_portal_t self:unix_stream_socket { accept getattr getopt ioctl read write };

# PORTAL-29: reaches its own /proc/self/fdinfo
allow olivares_portal_t self:dir search;

# PORTAL-30: reads the held pidfd's fdinfo (its Pid: line); the path is its own, never chosen by the caller
allow olivares_portal_t self:file { getattr open read };

# PORTAL-31: reaches /proc/<peer> of the one admitted caller domain; a peer in any other domain cannot be read and is refused
allow olivares_portal_t olivares_cli_t:dir search;

# PORTAL-32: reads the peer's cgroup after holding its pidfd, and again before each request; no /proc/<peer>/fd
allow olivares_portal_t olivares_cli_t:file { getattr open read };

# PORTAL-33: olivares-admins membership of a non-root peer from /etc/group and /etc/passwd (authlogin.fc:20,23; PORTAL-13 reaches /etc)
allow olivares_portal_t passwd_file_t:file { getattr open read };

# PORTAL-34: reaches lifecycle.lock; no add_name, remove_name or write in the directory
allow olivares_portal_t olivares_lifecycle_run_t:dir search;

# PORTAL-35: a read-only open and flock(LOCK_SH|LOCK_NB); the lock permission does not tell shared from exclusive, and the portal's role refuses exclusive in the source; no write, unlink or replacement of the inode
allow olivares_portal_t olivares_lifecycle_lock_t:file { getattr lock open read };

# PORTAL-36: reaches /var/lib/olivares-portal (files.fc:298)
allow olivares_portal_t var_lib_t:dir search;

# PORTAL-37: the root-owned parent of the leaf: search only, so the leaf's stat succeeds and nothing is created beside it
allow olivares_portal_t olivares_portal_var_lib_t:dir search;

# PORTAL-38: the operations leaf: stat, create store.lock and records, list the records, remove a record whose write failed, rename a rewritten record into place and fsync the directory (fsync has no SELinux permission)
allow olivares_portal_t olivares_portal_ops_t:dir { add_name getattr open read remove_name search write };

# PORTAL-39: store.lock (created once, flock exclusive) and the hostop/v1 records: create, read, write, fsync, rename over a record (unlink of the replaced inode); records and lock only, never an authority store
allow olivares_portal_t olivares_portal_ops_t:file { create getattr lock open read rename unlink write };

# ---- RCON ----

# RCON-10: the console's standard input and output are /dev/tty1, opened by PID 1
allow olivares_repair_console_t tty_device_t:chr_file { getattr ioctl read write };

# RCON-11: reaches /run/olivares-helpers
allow olivares_repair_console_t var_run_t:dir search;

# RCON-12: reaches the helpers' socket directory
allow olivares_repair_console_t olivares_helper_run_t:dir search;

# RCON-13: lstat of the power socket, then connect
allow olivares_repair_console_t olivares_helper_power_sock_t:sock_file { getattr write };

# RCON-14: the listening socket carries the power helper's domain (socket.c:1431-1500 loads the template's internal instance)
allow olivares_repair_console_t olivares_helper_power_t:unix_stream_socket connectto;

# RCON-15: its own client socket: write the document, half-close, read the answer
allow olivares_repair_console_t self:unix_stream_socket { connect create getattr read shutdown write };

# ---- HPWR ----

# HPWR-10: PID 1 creates /run/olivares-helpers with its file-context label (mkdir_parents_label)
allow init_t olivares_helper_run_t:dir { add_name create getattr search setattr write };

# HPWR-11: PID 1 binds the socket file with its file-context label and sets owner and mode
allow init_t olivares_helper_power_sock_t:sock_file { create getattr setattr unlink };

# HPWR-12: the accepted connection inherits the listener's label; SO_PEERCRED and SO_PEERPIDFD are getopt
allow olivares_helper_power_t self:unix_stream_socket { getattr getopt read shutdown write };

# HPWR-13: reaches /proc
allow olivares_helper_power_t proc_t:dir search;

# HPWR-14: reads the pidfd's fdinfo in its own /proc
allow olivares_helper_power_t self:file { getattr open read };

# HPWR-15: attests the one admitted invoker, the repair console; other peers stay unattested and are refused
allow olivares_helper_power_t olivares_repair_console_t:dir search;

# HPWR-16: reads the invoker's cgroup and status line
allow olivares_helper_power_t olivares_repair_console_t:file { getattr open read };

# HPWR-17: liveness by pidfd_send_signal with signal 0
allow olivares_helper_power_t olivares_repair_console_t:process signull;

# HPWR-18: reaches /etc/passwd
allow olivares_helper_power_t etc_t:dir search;

# HPWR-19: names the peer's account (root)
allow olivares_helper_power_t passwd_file_t:file { getattr open read };

# HPWR-20: runs systemctl in its own domain, no shell (systemd.fc:14 labels /usr/bin/systemctl)
allow olivares_helper_power_t systemd_systemctl_exec_t:file { execute execute_no_trans getattr map open read };

# HPWR-21: systemctl's own bus connection
allow olivares_helper_power_t self:unix_stream_socket { connect create };

# HPWR-22: systemctl 259 asks logind first (systemctl-start-special.c:201-214)
allow olivares_helper_power_t system_dbusd_var_run_t:dir search;

# HPWR-23: connects to the system bus
allow olivares_helper_power_t system_dbusd_var_run_t:sock_file write;

# HPWR-24: connects to the system bus
allow olivares_helper_power_t system_dbusd_t:unix_stream_socket connectto;

# HPWR-25: bus Hello and name lookups
allow olivares_helper_power_t system_dbusd_t:dbus send_msg;

# HPWR-26: the bus answers
allow system_dbusd_t olivares_helper_power_t:dbus send_msg;

# HPWR-27: Reboot/PowerOff method calls to logind (systemd_dbus_chat_logind, systemd.if:821)
allow olivares_helper_power_t systemd_logind_t:dbus send_msg;

# HPWR-28: logind's replies
allow systemd_logind_t olivares_helper_power_t:dbus send_msg;

# HPWR-29: systemctl falls back to PID 1's private socket when logind is absent (systemctl-start-special.c:209-214)
allow olivares_helper_power_t init_var_run_t:dir search;

# HPWR-30: the fallback connection
allow olivares_helper_power_t init_var_run_t:sock_file write;

# HPWR-31: the fallback connection
allow olivares_helper_power_t init_t:unix_stream_socket connectto;

# HPWR-32: the fallback starts reboot.target or poweroff.target (systemd.fc:48-51 label power_unit_file_t)
allow olivares_helper_power_t power_unit_file_t:service start;

# HPWR-33: systemctl stats /proc/1/root to detect a chroot; the kernel's ptrace read check is file read on PID 1's domain (Fedora systemd_systemctl_common: init_read_state)
allow olivares_helper_power_t init_t:dir search;

# HPWR-34: systemctl stats /proc/1/root to detect a chroot; the kernel's ptrace read check is file read on PID 1's domain (Fedora systemd_systemctl_common: init_read_state)
allow olivares_helper_power_t init_t:lnk_file { getattr read };

# HPWR-35: systemctl stats /proc/1/root to detect a chroot; the kernel's ptrace read check is file read on PID 1's domain (Fedora systemd_systemctl_common: init_read_state)
allow olivares_helper_power_t init_t:file read;

# HPWR-36: reaches /run/dbus and /run/systemd
allow olivares_helper_power_t var_run_t:dir search;

# ---- HBND ----

# HBND-10: PID 1 binds the socket file with its file-context label
allow init_t olivares_helper_bundle_sock_t:sock_file { create getattr setattr unlink };

# HBND-11: its connection; no invoker is admitted, so no peer /proc or passwd read is granted
allow olivares_helper_bundle_t self:unix_stream_socket { getattr getopt read shutdown write };

# HBND-12: reaches its state directory
allow olivares_helper_bundle_t var_lib_t:dir search;

# HBND-13: creates acts/ and out/, syncs the directory after a create
allow olivares_helper_bundle_t olivares_helper_bundle_var_lib_t:dir { add_name create getattr open read search write };

# HBND-14: creates the key and bundles once, never replaces; reads its own files
allow olivares_helper_bundle_t olivares_helper_bundle_var_lib_t:file { create getattr open read write };

# HBND-15: PID 1 creates and chowns the state directory and bind-mounts it writable under ProtectSystem=strict
allow init_t olivares_helper_bundle_var_lib_t:dir { create getattr mounton setattr };

# HBND-16: /etc/os-release is a link to /usr/lib/os-release (lib_t, read by every domain in Fedora, domain.te:233-236)
allow olivares_helper_bundle_t etc_t:lnk_file { getattr read };

# HBND-17: reaches /proc/sys
allow olivares_helper_bundle_t proc_t:dir search;

# HBND-18: reaches /proc/sys/kernel
allow olivares_helper_bundle_t sysctl_t:dir search;

# HBND-19: kernel release and boot id
allow olivares_helper_bundle_t sysctl_kernel_t:file { getattr open read };

# ---- SNAP ----

# SNAP-10: reaches /boot
allow olivares_snapshotcore_t boot_t:dir { getattr search };

# SNAP-11: creates /boot/olivares on first use
allow olivares_snapshotcore_t boot_t:dir { add_name write };

# SNAP-12: a /boot/olivares created at run time is labeled olivares_boot_t, not boot_t
type_transition olivares_snapshotcore_t boot_t:dir olivares_boot_t "olivares";

# SNAP-13: journal/ and store/ directories; SyncDir and ReadDir open the directory
allow olivares_snapshotcore_t olivares_boot_t:dir { add_name create getattr open read remove_name search write };

