# Fedora types and classes the rules use
#

gen_require(`
	type NetworkManager_etc_rw_t;
	type NetworkManager_etc_t;
	type NetworkManager_t;
	type NetworkManager_var_run_t;
	type admin_home_t;
	type boot_t;
	type cert_t;
	type cloud_init_exec_t;
	type cloud_init_t;
	type cloud_var_lib_t;
	type device_t;
	type dns_port_t;
	type etc_t;
	type fixed_disk_device_t;
	type home_root_t;
	type http_port_t;
	type init_t;
	type init_var_run_t;
	type lib_t;
	type locale_t;
	type machineid_t;
	type modules_object_t;
	type net_conf_t;
	type node_t;
	type passwd_file_t;
	type power_unit_file_t;
	type proc_t;
	type root_t;
	type ssh_home_t;
	type sysctl_kernel_t;
	type sysctl_t;
	type system_dbusd_t;
	type system_dbusd_var_run_t;
	type systemd_logind_t;
	type systemd_networkd_unit_file_t;
	type systemd_resolved_var_run_t;
	type systemd_systemctl_exec_t;
	type systemd_tmpfiles_t;
	type systemd_unit_file_t;
	type tty_device_t;
	type user_devpts_t;
	type user_home_dir_t;
	type var_lib_t;
	type var_run_t;
	class blk_file { getattr };
	class capability { chown dac_read_search };
	class chr_file { append getattr ioctl read write };
	class dbus { send_msg };
	class dir { add_name create getattr ioctl mounton open read remove_name rename reparent rmdir search setattr write };
	class fd { use };
	class file { append create execute execute_no_trans getattr link lock map open read rename setattr unlink write };
	class lnk_file { getattr read };
	class netlink_route_socket { bind create getattr nlmsg_read read write };
	class process { execmem signull };
	class service { enable start status };
	class sock_file { create getattr setattr unlink write };
	class system { reload status };
	class tcp_socket { accept bind connect create getattr getopt listen name_bind name_connect node_bind read setopt shutdown write };
	class udp_socket { bind connect create getattr getopt node_bind read setopt write };
	class unix_stream_socket { accept bind connect connectto create getattr getopt ioctl listen read setopt shutdown write };
')

