# ---- NGRD ----

# NGRD-06: PID 1 binds guard.sock in /run/olivares-net-guard-api, creating the directory with its label when the initializer has not
allow init_t olivares_net_guard_api_run_t:dir { add_name create getattr search setattr write };

# NGRD-07: PID 1 binds guard.sock with its label, root:olivares-portal 0660, and unlinks a stale socket
allow init_t olivares_net_guard_sock_t:sock_file { create getattr setattr unlink };

# NGRD-08: PID 1 creates the listener in the guard's exec domain (socket.c:1480-1500) and passes it as the one descriptor
allow init_t olivares_net_guard_t:unix_stream_socket { bind create getattr listen setopt };

# NGRD-09: the inherited listener and its connections (SO_PEERCRED and SO_PEERPIDFD are getopt), its bus connection, and its netrestore connection, half-closed after the request
allow olivares_net_guard_t self:unix_stream_socket { accept connect create getattr getopt read shutdown write };

# NGRD-10: StateDirectory: PID 1 creates /var/lib/olivares-net-guard 0700 for the static account with its label and binds it writable
allow init_t olivares_net_guard_var_lib_t:dir { create getattr mounton setattr };

# NGRD-11: reaches /var/lib/olivares-net-guard (files.fc:298)
allow olivares_net_guard_t var_lib_t:dir search;

# NGRD-12: the bounded journal: creates acts/, lists it, creates a .window- temporary, links or renames it to <operation>.json, removes the temporary and fsyncs the directory (fsync has no permission)
allow olivares_net_guard_t olivares_net_guard_var_lib_t:dir { add_name create getattr open read remove_name search write };

# NGRD-13: writes, fsyncs, links or renames and reads the window records (0600); no symlink is followed
allow olivares_net_guard_t olivares_net_guard_var_lib_t:file { create getattr link open read rename unlink write };

# NGRD-14: the root initializer adds its three directories to /run; the named type transitions give each its own type, and the domain may create no other kind of /run entry
allow olivares_net_guard_t var_run_t:dir { add_name search write };

# NGRD-15: /run/olivares-network, created by the initializer, gets olivares_network_run_t (the file context of the same path)
type_transition olivares_net_guard_t var_run_t:dir olivares_network_run_t "olivares-network";

# NGRD-16: /run/olivares-net-guard-api, created by the initializer, gets olivares_net_guard_api_run_t (the file context of the same path)
type_transition olivares_net_guard_t var_run_t:dir olivares_net_guard_api_run_t "olivares-net-guard-api";

# NGRD-17: /run/olivares-netrestore, created by the initializer, gets olivares_netrestore_run_t (the file context of the same path)
type_transition olivares_net_guard_t var_run_t:dir olivares_netrestore_run_t "olivares-netrestore";

# NGRD-18: the root initializer gives its directories and files to the olivares-net-guard group; the guard's own unit has an empty CapabilityBoundingSet, so the guard never holds it
allow olivares_net_guard_t self:capability chown;

