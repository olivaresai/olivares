#
# The Olivares AI appliance's SELinux policy module. GENERATED by generate.py from access.tsv and
# contexts.tsv: change a row there, run python3 appliance/selinux/generate.py and commit both; do not
# edit this file. Each rule follows the id of the row that requires it and the row's reason.

policy_module(olivares, 1.0.0)

