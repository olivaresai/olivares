//
// The formats A2 delivers, declared once and read by the assembly scripts, by the recipe's
// shape gate (appliance/images/formats_test.go) and by the Taskfile target. The sizes are
// PREDICTIONS from the package set, not measurements: no image has been built yet, and the
// first hosted build replaces expected_bytes_about with what it weighed. The ceiling is not
// a prediction: a file of a GitHub release may not pass 2 GiB, and the assembly refuses to
// hand over an artifact that does. Each artifact names its edition; every consumer — the
// assemblies, the boot battery, the NoCloud probe — selects by edition (the server edition
// when none is named) and refuses an edition the declaration does not carry, so one edition's
// file names are never mistaken for another's.
{
  "product": "Olivares Server",
  "vendor": "Olivares.AI",
  "arch": "amd64",
  "release_asset_max_bytes": 2147483648,
  "release_asset_limit": "one file of a GitHub release may not pass 2 GiB, with up to 1000 files per release (docs.github.com, About releases, read 2026-09-19; design 10.2, kept by 11.1 while distribution is GitHub only)",
  "artifacts": [
    {
      "edition": "server",
      "format": "iso",
      "file": "olivares-appliance-server-amd64.iso",
      "script": "iso.sh",
      "manifest": "olivares-appliance-server-amd64.iso.manifest.json",
      "max_bytes": 2147483648,
      "split": false,
      "split_part_max_bytes": 0,
      "expected_bytes_about": 1288490188
    },
    {
      "edition": "server",
      "format": "qcow2",
      "file": "olivares-appliance-server-amd64.qcow2",
      "script": "qcow2.sh",
