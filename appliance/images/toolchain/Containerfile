# The one Debian 13 builder. Python package resolution is entirely explicit.
FROM debian:13@sha256:d5ce19d4736f0ebbacd686d1040271a5aeb0cc920f5990c1bfae1717627f0674
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /toolchain
COPY input-lock.json bootstrap.sh install.py ./
RUN bash /toolchain/bootstrap.sh
RUN python3 /toolchain/install.py fetch
# No build-backend or dependency code may fetch an implicit input.
RUN --network=none python3 /toolchain/install.py install
ENV PATH="/opt/kiwi/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
RUN --network=none python3 /toolchain/install.py qualify
CMD ["kiwi-ng", "--version"]
