  "id": "appliance-image-toolchain-debian13-amd64",
  "invocation": {
    "container_runtime": "docker",
    "containerfile": "appliance/images/toolchain/Containerfile",
    "image_tag": "olivares-appliance-image-toolchain:debian13-kiwi-11.0.4",
    "invocation_note": "A container build of a disk image is privileged: the documented route starts the runtime through sudo, shares host device nodes for loop devices and adds the capabilities above. Non-privileged builds are not possible in container mode, so this toolchain runs only on a disposable runner that shares no host with another build.",
    "required_capabilities": [
      "SYS_ADMIN",
      "MKNOD",
      "AUDIT_WRITE",
      "AUDIT_CONTROL"
    ],
    "shares_host_dev": true,
    "version_command": [
      "kiwi-ng",
      "--version"
    ]
  },
  "probe": {
    "accelerator_preference": [
      "kvm",
      "tcg"
    ],
    "container_timeout_seconds": 300,
    "loop_image_bytes": 67108864,
    "probe_note": "The probe allocates only the small image above and starts one machine that never leaves prelaunch. It proves accelerator initialization, a toolchain that starts and reports its version, and loop and mount privilege. It proves no guest boot and no image output.",
    "qemu_binary": "qemu-system-x86_64",
    "qemu_machine": "q35",
    "qemu_timeout_seconds": 30,
