#
# The public product repository (D's S3), rendered from D's packaging/repositories/dnf-repo.template (S3 0621ff27).
# Both signature checks are set on their own, and the trust anchor is the preinstalled key, pinned by fingerprint in
# the recipe (package-repository-key.json), never a repository URL. The entitled repository file is written at run time
# by S7, with its credential; the image ships neither.
[olivares]
name=Olivares Server stable
baseurl=https://packages.olivares.ai/stable/rpm/x86_64
enabled=1
pkg_gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-olivares-package-repository
metadata_expire=0
type=rpm-md
