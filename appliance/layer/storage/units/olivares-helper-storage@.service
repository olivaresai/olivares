#
# One connection to the storage helper, started by olivares-helper-storage.socket with the
# connection as standard input and output. The helper takes no argument and no path; it reads
# the storage inventory from UDisks2 over the system bus (GetManagedObjects, EnableModule of the
# LVM2 module and the manager's Can methods) and from the kernel (the boot id, a loop device's
# LOOP_GET_STATUS64, the first MiB of a disk without a serial and sysfs holders), and changes no
# disk. It runs as root, which owns the block device nodes it opens read-only, with no
# capability, no network and a read-only file system. The devices stay visible because the
# helper reads them.
[Unit]
Description=Appliance storage inventory helper (one connection)
Documentation=https://github.com/olivaresai/olivares

[Service]
ExecStart=/usr/libexec/olivares/olivares-portal-storage
User=root
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
