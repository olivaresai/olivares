[Unit]
Description=Appliance Console local API socket
After=systemd-sysusers.service systemd-tmpfiles-setup.service
Requires=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/olivares-portal-api/local.sock
SocketUser=root
SocketMode=0666
DirectoryMode=0755
PassCredentials=yes
Accept=no
FileDescriptorName=local
Service=olivares-portal.service

# Finite limits remain enabled. Service restart delay handles credential loss;
# polling is an additional flood control, not the proof of restart spacing.
PollLimitIntervalSec=15s
PollLimitBurst=1
TriggerLimitIntervalSec=10s
TriggerLimitBurst=5
