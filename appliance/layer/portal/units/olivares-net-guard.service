[Unit]
Description=NetworkManager transaction guard
Requires=olivares-net-guard.socket NetworkManager.service
After=olivares-net-guard.socket NetworkManager.service dbus.service polkit.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
ExecStart=/usr/libexec/olivares/olivares-net-guard
User=olivares-net-guard
Group=olivares-net-guard
StateDirectory=olivares-net-guard
StateDirectoryMode=0700
Restart=on-failure
RestartSec=15
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=default
ProcSubset=all
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
