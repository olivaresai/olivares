#
# The units helper's socket. Each connection starts one instance of
# olivares-helper-units@.service (Accept=yes), which reads one document, {"op", "unit", "lines",
# "operation_id"}, and admits its invoker from the connection itself: the account of the peer's
# credentials, and the unit and controlling terminal of the process the peer's pidfd names. It is
# a module helper: the seam admits the Appliance Console's own process alone, for list, status,
# logs and the effects. The socket is root's, group olivares-portal, mode 0660, so only root and
# the console's account can connect, and connecting is necessary, never sufficient. The image's
# preset and the portal package enable it.
[Unit]
Description=Appliance units helper socket
Documentation=https://github.com/olivaresai/olivares

[Socket]
ListenStream=/run/olivares-helpers/units.sock
Accept=yes
SocketUser=root
SocketGroup=olivares-portal
SocketMode=0660
DirectoryMode=0755
MaxConnections=4

[Install]
WantedBy=sockets.target
