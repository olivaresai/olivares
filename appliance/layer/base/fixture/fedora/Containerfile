# The disposable Fedora 44 system of the appliance base fixture, the rpm counterpart of the
# Debian 13 one in ../Containerfile: systemd as PID 1, cloud-init as the host-settings owner
# reading a NoCloud seed, OpenSSH for the host keys cloud-init generates, the product installed
# from its own files by its own postinstall, and olivares-appliance-base installed from the
# built rpm the way the image recipe installs it: offline, starting nothing. dnf installs the
# system and rpm installs the package; nothing here runs a Debian tool. The build context is the
# same staging directory as ../Containerfile's, with olivares-appliance-base.rpm in place of the
# deb. A container is component evidence; it does not qualify an image, a hypervisor or
# firmware, and it runs under the host's SELinux policy, not Fedora's, so it measures nothing
# about the appliance's SELinux labels or policy: the image run does.
# fedora:44 as Docker Hub listed it on 2026-09-27 (pushed 2026-08-26), pinned by its index digest.
FROM fedora:44@sha256:43b29f65a41eb9c35e1cd5323e3bdf3b655c2357a9f4f1ff2f9c2798e5045d80
RUN dnf -y --setopt=install_weak_deps=False install systemd dbus-broker cloud-init openssh-server \
    shadow-utils util-linux NetworkManager polkit udisks2 udisks2-lvm2 lvm2 iproute \
 && dnf clean all
# A template carries no instance identity: no SSH host key and an empty machine ID.
RUN rm -f /etc/ssh/ssh_host_* && : > /etc/machine-id
COPY cloud-init.conf /etc/cloud/cloud.cfg.d/99-appliance-fixture.cfg
COPY olivares /usr/bin/olivares
COPY olivares.service /usr/lib/systemd/system/olivares.service
COPY package-init-systemd.txt /usr/lib/olivares/package-init
COPY olivares.env.example /etc/olivares/olivares.env
COPY postinstall.sh /tmp/olivares-postinstall.sh
RUN sh /tmp/olivares-postinstall.sh && rm /tmp/olivares-postinstall.sh
COPY olivares-appliance-base.rpm /tmp/olivares-appliance-base.rpm
RUN rpm -i /tmp/olivares-appliance-base.rpm && rm /tmp/olivares-appliance-base.rpm
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
