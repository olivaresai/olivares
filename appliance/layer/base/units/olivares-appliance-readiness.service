#
# The second half of an appliance's first boot. The first-boot unit queues the product's start
# but cannot wait for it. This unit, pulled in by the first-boot unit and ordered after the
# product, runs the same command: completed stages are compared, not repeated, and first boot
# becomes ready only when the product's own readiness endpoint, its store and its identity files
# pass. Until then the record says pending. It is wanted by no target, so no target waits for it.
[Unit]
Description=Olivares Server first-boot readiness
Documentation=https://github.com/olivaresai/olivares/tree/main/appliance
After=olivares.service olivares-appliance-firstboot.service
ConditionPathExists=!/var/lib/olivares-appliance/ready

[Service]
Type=oneshot
ExecStart=/usr/bin/appliance-firstboot apply
ImportCredential=olivares.appliance.answers
StateDirectory=olivares-appliance
StateDirectoryMode=0700
# appliance-firstboot's own 10-minute deadline ends first, so a slow poll records why it stopped.
TimeoutStartSec=15min

# --- hardening: the product unit's set (packaging/systemd/olivares.service) by the same values,
# except where a line below says why first boot needs a different one.
NoNewPrivileges=true
# ProtectSystem: strict; first boot writes only the explicit ReadWritePaths below, with no agent workspace.
ProtectSystem=strict
# Writable: the product configuration the product's generator writes, the drop-in directory, and
# the Appliance Console's directory, where generate-product-config publishes the console's
# selection (the base package's postinstall creates it). Each may be missing ("-"): the stage that
# needs one then records its refusal, where a missing required path would stop the unit before
# first boot could record anything.
# The verified handoff writes only its cloud-init ownership drop-in.
# The product data directory is writable for one reason: prepare-setup-delivery mints the one-time
# setup token there, before the product first starts, and gives it to the product service account.
ReadWritePaths=-/etc/olivares -/etc/systemd/system/olivares.service.d -/etc/olivares-portal -/etc/cloud/cloud.cfg.d -/var/lib/olivares
# ProtectHome: read-only, not true: verify-host-settings reads the authorized SSH keys in /home and /root.
ProtectHome=read-only
# PrivateTmp: true; first boot does not share temporary files with agent or MCP runtimes.
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# MemoryDenyWriteExecute: true; first boot runs Go binaries and requires no executable JIT memory.
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# SystemCallFilter: @chown lets prepare-setup-delivery give the minted token to the product account;
# first boot launches no agent or MCP children and does not need the product's Landlock calls.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=@chown
# CapabilityBoundingSet: CAP_DAC_READ_SEARCH, CAP_DAC_OVERRIDE and CAP_CHOWN where the product keeps
# none: first boot runs as root; it reads other accounts' authorized keys and the product's 0750 data
# directory, writes the setup token into that directory and gives the token to the product service
# account. Nothing else.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN
AmbientCapabilities=
# UMask: 0077, tighter than the product's 0027: first boot writes only root-private records.
UMask=0077
