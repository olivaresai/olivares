#
# First boot of an Olivares appliance, installed by olivares-appliance-base. It reads one
# appliance-answers/v1 document from its carriers, verifies what cloud-init applied, has the
# product's own generator write the product configuration, and starts the product only after
# the setup-token delivery and the host firewall are measured. Each completed stage is recorded
# atomically in /var/lib/olivares-appliance/state.json; a restart compares instead of
# repeating. Once first boot is ready the unit is skipped. It never prints a setup token.
#
# Ordering. Upstream cloud-init's cloud-final.service and cloud-init.target are ordered after
# multi-user.target, and a target is ordered after every unit it wants unless that unit sets
# DefaultDependencies=no (systemd.target(5)). This unit is wanted by multi-user.target and
# waits for cloud-final.service, so it sets DefaultDependencies=no: multi-user.target does not
# wait for it, and it runs once multi-user.target and cloud-init's final stage are done. It
# restates the dependencies systemd.service(5) gives a service by default. It is not ordered
# before the product: first boot alone enables and starts the product, and a product unit
# ordered after this one would, once enabled, put multi-user.target in a cycle again. The
# readiness unit it pulls in measures the product after the product starts. Without cloud-init
# the ordering on cloud-final.service is inert and verify-host-settings refuses.
[Unit]
Description=Olivares Server first boot
Documentation=https://github.com/olivaresai/olivares/tree/main/appliance
DefaultDependencies=no
Requires=sysinit.target
Wants=network-online.target olivares-appliance-readiness.service
After=sysinit.target basic.target network-online.target multi-user.target cloud-final.service
Before=olivares-appliance-readiness.service shutdown.target
Conflicts=shutdown.target
ConditionPathExists=!/var/lib/olivares-appliance/ready

[Service]
Type=oneshot
ExecStart=/usr/bin/appliance-firstboot apply
# The answers may arrive as a system credential (SMBIOS type 11, the kernel command line or
# a container manager); a missing credential is not an error.
ImportCredential=olivares.appliance.answers
StateDirectory=olivares-appliance
StateDirectoryMode=0700
# appliance-firstboot's own 10-minute deadline ends first, so a slow run records why it stopped.
TimeoutStartSec=15min

# --- hardening: the product unit's set (packaging/systemd/olivares.service) by the same values,
# except where a line below says why first boot needs a different one.
NoNewPrivileges=true
# ProtectSystem: strict; first boot writes only the explicit ReadWritePaths below, with no agent workspace.
ProtectSystem=strict
# Writable: the product configuration the product's generator writes, the drop-in directory, and
# the Appliance Console's directory, where generate-product-config publishes the console's
# selection (the base package's postinstall creates it). Each may be missing ("-"): the stage that
# needs one then records its refusal, where a missing required path would stop the unit before
# first boot could record anything.
# The verified handoff writes only its cloud-init ownership drop-in.
# The product data directory is writable for one reason: prepare-setup-delivery mints the one-time
# setup token there, before the product first starts, and gives it to the product service account.
ReadWritePaths=-/etc/olivares -/etc/systemd/system/olivares.service.d -/etc/olivares-portal -/etc/cloud/cloud.cfg.d -/var/lib/olivares
# ProtectHome: read-only, not true: verify-host-settings reads the authorized SSH keys in /home and /root.
ProtectHome=read-only
# PrivateTmp: true; first boot does not share temporary files with agent or MCP runtimes.
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# MemoryDenyWriteExecute: true; first boot runs Go binaries and requires no executable JIT memory.
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
# SystemCallFilter: @chown lets prepare-setup-delivery give the minted token to the product account;
# first boot launches no agent or MCP children and does not need the product's Landlock calls.
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallFilter=@chown
# CapabilityBoundingSet: CAP_DAC_READ_SEARCH, CAP_DAC_OVERRIDE and CAP_CHOWN where the product keeps
# none: first boot runs as root; it reads other accounts' authorized keys and the product's 0750 data
# directory, writes the setup token into that directory and gives the token to the product service
# account. Nothing else.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN
AmbientCapabilities=
# UMask: 0077, tighter than the product's 0027: first boot writes only root-private records.
UMask=0077

[Install]
WantedBy=multi-user.target
