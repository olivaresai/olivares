// The guard alone holds these NetworkManager actions; bus root-only methods remain root-only.
polkit.addRule(function (action, subject) {
    if (subject.user !== "olivares-net-guard") return polkit.Result.NOT_HANDLED;
    var actions = [
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.checkpoint-rollback"
    ];
    return actions.indexOf(action.id) >= 0 ? polkit.Result.YES : polkit.Result.NOT_HANDLED;
});
