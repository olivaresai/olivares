#
# The support-bundle helper's socket. Each connection starts one instance of
# olivares-helper-support-bundle@.service (Accept=yes). The helper admits no invoker yet: the
# verb stays unavailable until its consumer, peer, spool owner and path are admitted together.
# The socket is root's, mode 0600.
#
# Packaged, not enabled: there is no [Install] section.
[Unit]
Description=Appliance support-bundle helper socket
Documentation=https://github.com/olivaresai/olivares

[Socket]
ListenStream=/run/olivares-helpers/support-bundle.sock
Accept=yes
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0755
MaxConnections=4
