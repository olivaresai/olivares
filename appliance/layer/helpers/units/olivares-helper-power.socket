#
# The power helper's socket. Each connection starts one instance of
# olivares-helper-power@.service (Accept=yes), which reads one document, {"verb": "reboot"} or
# {"verb": "shutdown"} with its operation id, and admits its invoker from the connection itself:
# the account of the peer's credentials, and the unit and controlling terminal of the process the
# peer's pidfd names. Today that admits the repair console on tty1 alone, and no instance
# performs a reboot or a shutdown until the appliance's kernel is proven to give it the peer's
# pidfd. The socket is root's, mode 0600, so only a root process can connect, and being root is
# necessary, never sufficient.
#
# Packaged, not enabled: there is no [Install] section. Enabling it is the image's decision, with
# the repair console's.
[Unit]
Description=Appliance power helper socket
Documentation=https://github.com/olivaresai/olivares

[Socket]
ListenStream=/run/olivares-helpers/power.sock
Accept=yes
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0755
MaxConnections=4
