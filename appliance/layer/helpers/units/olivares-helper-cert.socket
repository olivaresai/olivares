#
# The certificate helper's socket. Each connection starts one instance of
# olivares-helper-cert@.service (Accept=yes), which reads one document, begin, install or
# generate with its operation id, and admits its invoker from the connection itself. Today that
# admits the repair console on tty1 alone, for generate; begin and install admit nobody until the
# Appliance Console's certificate audience is adopted. No instance performs a subcommand until the
# appliance's kernel is proven to give it the peer's pidfd. The socket is root's, mode 0600, so
# only a root process can connect, and being root is necessary, never sufficient.
#
# Packaged, not enabled: there is no [Install] section. Enabling it is the image's decision, with
# the repair console's.
[Unit]
Description=Appliance certificate helper socket
Documentation=https://github.com/olivaresai/olivares

[Socket]
ListenStream=/run/olivares-helpers/cert.sock
Accept=yes
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0755
MaxConnections=4
