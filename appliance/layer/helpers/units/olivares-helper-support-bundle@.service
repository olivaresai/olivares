#
# One connection to the support-bundle helper, started by olivares-helper-support-bundle.socket
# with the connection as standard input and output. The helper runs unprivileged, as its static,
# non-login account olivares-support-bundle, with no supplementary group; the portal package
# declares that account before this unit can start. Its only writable place is its state
# directory, /var/lib/olivares-support-bundle, mode 0700, which holds its key and its acts/ and
# out/ directories, each 0700. It reads files every account may read and names every bundle in
# out/ from a nonce it issued under its own key. Because the account is static, the template
# states itself what DynamicUser= would imply: ProtectSystem=strict, ProtectHome=, PrivateTmp=,
# NoNewPrivileges=, RestrictSUIDSGID= and RemoveIPC=yes, which removes the account's System V and
# POSIX IPC objects when the instance stops.
[Unit]
Description=Appliance support-bundle helper (one connection)
Documentation=https://github.com/olivaresai/olivares

[Service]
ExecStart=/usr/libexec/olivares/olivares-portal-support-bundle
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=30
User=olivares-support-bundle
StateDirectory=olivares-support-bundle
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
