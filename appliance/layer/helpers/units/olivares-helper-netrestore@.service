[Unit]
Description=Network netrestore helper (one connection)

[Service]
ExecStart=/usr/libexec/olivares/olivares-portal-netrestore
User=root
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=default
RestrictNamespaces=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
AmbientCapabilities=
UMask=0077
ReadWritePaths=/run/NetworkManager/system-connections /run/olivares-netrestore
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_READ_SEARCH
RestrictAddressFamilies=AF_UNIX
