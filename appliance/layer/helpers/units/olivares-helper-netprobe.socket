[Unit]
Description=Network netprobe helper socket
Requires=olivares-network-runtime.service
After=olivares-network-runtime.service

[Socket]
ListenStream=/run/olivares-helpers/netprobe.sock
Accept=yes
SocketUser=root
SocketGroup=olivares-portal
SocketMode=0660
DirectoryMode=0755
MaxConnections=4

[Install]
WantedBy=sockets.target
