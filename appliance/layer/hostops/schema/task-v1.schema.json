{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "operation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{32}$"
      }
    }
  },
  "required": [
    "task_id",
    "operation_ids"
  ]
}
