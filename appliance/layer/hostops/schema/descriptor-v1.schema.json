{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "descriptor-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "module": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "verb": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "category": {
      "enum": [
        "Status",
        "Network",
        "Services",
        "Packages",
        "Updates",
        "Storage",
        "System",
        "License and modules",
        "Apps",
        "Tools and accounts",
        "Support"
      ]
    },
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "boolean",
                  "integer"
                ]
              },
              "enum": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "additionalProperties": {
          "const": false
        }
      },
      "required": [
        "type",
        "properties",
        "required",
        "additionalProperties"
      ]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
      }
    },
    "consequence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "confirmation": {
      "enum": [
        "none",
        "confirm",
        "typed"
      ]
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "product-up",
          "product-down-repair",
          "tty1",
          "timer",
          "guard",
          "projection",
          "unavailable"
        ]
      }
    },
    "act_verb": {
      "type": "string",
      "maxLength": 1024
    },
    "audience": {
      "type": "string",
      "maxLength": 1024
    },
    "equivalent_command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "output_schema": {
      "const": "hostop-v1.schema.json"
    },
    "surfaces": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "web",
          "cli",
          "tui"
        ]
      }
    }
  },
  "required": [
    "id",
    "module",
    "verb",
    "title",
    "category",
    "input_schema",
    "preconditions",
    "consequence",
    "confirmation",
    "modes",
    "act_verb",
    "audience",
    "equivalent_command",
    "output_schema",
    "surfaces"
  ]
}
