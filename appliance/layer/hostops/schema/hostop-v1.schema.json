{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hostop-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "module": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "verb": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "target": {
      "type": "string",
      "pattern": "^(network|packages|system|app:ingress|unit:[A-Za-z0-9:._@-]{1,256}|drive:[0-9a-f]{64}|vg:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|app:[a-z][a-z0-9-]{0,31})$"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "mode": {
      "enum": [
        "product-up",
        "product-down-repair",
        "tty1",
        "timer",
        "guard",
        "projection"
      ]
    },
    "surface": {
      "enum": [
        "web",
        "cli",
        "tui",
        "tty1",
        "system"
      ]
    },
    "actor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:@-]{1,128}$"
    },
    "state": {
      "enum": [
        "planned",
        "running",
        "succeeded",
        "failed",
        "rolled_back",
        "partial"
      ]
    },
    "outcome": {
      "const": "unknown"
    },
    "postconditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
      },
      "maxItems": 64
    },
    "effect_pending": {
      "type": "boolean"
    },
    "log_ref": {
      "type": "string",
      "pattern": "^journal:OLIVARES_OPERATION_ID=[0-9a-f]{32}$"
    },
    "reason": {
      "const": "abandoned"
    }
  },
  "required": [
    "operation_id",
    "task_id",
    "module",
    "verb",
    "target",
    "plan_digest",
    "mode",
    "surface",
    "actor",
    "state",
    "log_ref"
  ],
  "description": "Operation read model. Module and verb must also be declared in the owning module catalog; log_ref must name this operation_id.",
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "running"
          }
        }
      },
      "then": {
        "required": [
          "outcome"
        ]
      },
      "else": {
        "not": {
          "required": [
            "outcome"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "succeeded",
              "rolled_back"
            ]
          }
        }
      },
      "then": {
        "required": [
          "postconditions"
        ],
        "properties": {
          "postconditions": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "effect_pending"
        ],
        "properties": {
          "effect_pending": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "running"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "reason"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "enum": [
              "failed",
              "partial"
            ]
          }
        }
      }
    }
  ]
}
