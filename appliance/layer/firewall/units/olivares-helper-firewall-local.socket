#
# The firewall's local entry point socket. Each connection starts one instance of
# olivares-helper-firewall-local@.service (Accept=yes), which reads one document, status, or revert
# or restore with its operation id, and admits its invoker from the connection itself: the repair
# console on tty1 alone. No instance performs revert or restore until the appliance's kernel is
# proven to give it the peer's pidfd. The socket is root's, mode 0600, so only a root process can
# connect, and being root is necessary, never sufficient. The Appliance Console reaches the firewall
# through olivares-helper-firewall.socket; this socket is not a second audience of that one.
#
# Packaged, not enabled: there is no [Install] section. The repair console's unit starts it with
# Wants= and After=.
[Unit]
Description=Appliance firewall local entry point socket
Documentation=https://github.com/olivaresai/olivares

[Socket]
ListenStream=/run/olivares-helpers/firewall-local.sock
Accept=yes
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0755
MaxConnections=4
