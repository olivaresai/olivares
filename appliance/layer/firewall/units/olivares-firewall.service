#
# The host firewall's boot load. Before network-pre.target, so NetworkManager configures no
# interface before the table is loaded, it loads the last confirmed policy, never a pending one,
# publishes its measurement and closes the window a reboot ended. With no confirmed policy it
# confirms the first one only after first boot has published the console selection; earlier it
# loads nothing. First boot's firewall stage restarts this unit. It conflicts with
# nftables.service, whose start flushes every table. It runs as root with CAP_NET_ADMIN alone, in
# the host's network namespace, and runs sshd -T once to measure the operator's SSH port.
[Unit]
Description=Appliance host firewall: load the last confirmed policy
Documentation=https://github.com/olivaresai/olivares
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
After=local-fs.target
Conflicts=shutdown.target nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/olivares/olivares-portal-firewall --boot-load
User=root
StandardError=journal
TimeoutStartSec=90
NoNewPrivileges=yes
ProtectSystem=strict
StateDirectory=olivares-firewall
StateDirectoryMode=0700
RuntimeDirectory=olivares-firewall
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=sysinit.target
