#
# The host firewall's guard. Once a second it takes the network lock without waiting and
# reverts each unconfirmed window whose deadline passed, loading the confirmed policy again and
# publishing its measurement; a busy lock is left for the next tick. It runs as root with
# CAP_NET_ADMIN alone, in the host's network namespace.
[Unit]
Description=Appliance host firewall guard: revert unconfirmed changes at their deadline
Documentation=https://github.com/olivaresai/olivares
Wants=olivares-firewall.service
After=olivares-firewall.service

[Service]
Type=simple
ExecStart=/usr/libexec/olivares/olivares-portal-firewall --guard
Restart=always
RestartSec=2
User=root
StandardError=journal
NoNewPrivileges=yes
ProtectSystem=strict
StateDirectory=olivares-firewall
StateDirectoryMode=0700
RuntimeDirectory=olivares-firewall
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
