#
# One connection to the firewall's local entry point, started by olivares-helper-firewall-local.socket
# with the connection as standard input and output. The program takes no argument and no path. It
# answers through the same firewall owner as olivares-helper-firewall@.service: the same state
# directory, where it also records each restoration under restorations/, the same network lock, the
# same nft -f - load and nft -j list read-back, and the same measurement. restore derives its target
# on this host, as the boot load derives the first policy: first boot's record, the published console
# selection, sshd -T once for the operator's SSH port, and the kernel's list of links. It runs as root
# with CAP_NET_ADMIN alone, because the kernel refuses nftables netlink messages from a sender without
# it, root included; and in the host's network namespace, because a private one would hold a private
# table. It opens no IP socket.
[Unit]
Description=Appliance firewall local entry point (one connection)
Documentation=https://github.com/olivaresai/olivares

[Service]
ExecStart=/usr/libexec/olivares/olivares-portal-firewall-local
User=root
StandardInput=socket
StandardOutput=socket
StandardError=journal
RuntimeMaxSec=60
NoNewPrivileges=yes
ProtectSystem=strict
StateDirectory=olivares-firewall
StateDirectoryMode=0700
RuntimeDirectory=olivares-firewall
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
UMask=0077
