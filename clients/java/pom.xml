<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ai.olivares</groupId>
  <artifactId>olivares-client</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>

  <name>olivares-client</name>
  <description>First-party Java client for the Olivares AI control plane API (v1).</description>
  <url>https://olivares.ai/docs</url>

  <!--
    Pre-1.0 while the product is pre-1.0 (the stability policy's support windows
    bind from GA); from GA on the package MAJOR tracks the API contract major
    (ApiMetadata.API_VERSION). The operation layer (Client.java, ApiMetadata.java)
    is generated by `task sdk:generate` and drift-checked by `task sdk:check`.
  -->

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <organization>
    <name>Olivares.AI</name>
    <url>https://olivares.ai</url>
  </organization>

  <developers>
    <developer>
      <name>Olivares.AI</name>
      <url>https://olivares.ai</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/olivaresai/olivares.git</connection>
    <developerConnection>scm:git:https://github.com/olivaresai/olivares.git</developerConnection>
    <url>https://github.com/olivaresai/olivares/tree/main/clients/java</url>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <!-- Zero third-party RUNTIME dependencies, by design (the dependency surface
         is part of the threat model). JUnit is test-scope only. -->
    <junit.version>5.11.4</junit.version>
    <stability.policy>https://olivares.ai/docs</stability.policy>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      `mvn -Prelease package` additionally builds the sources + javadoc jars that
      Maven Central requires. Doclint is disabled: the generated operation layer
      embeds route templates like /v1/agents/{id} in its Javadoc, which strict
      doclint would reject (it never affects compilation or the published API).
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <configuration>
              <doclint>none</doclint>
              <failOnError>false</failOnError>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
