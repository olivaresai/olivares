#
# The eBPF/Tetragon backstop connector (connectors/ebpf/cmd/ebpf-source).
#
# This is the ZERO-capability half of the privilege split (docs/SECURITY-HARDENING.md, §6): it
# holds NO kernel capabilities, reads only Tetragon's export file over a shared
# volume, and pushes normalized access edges through the SDK. The image is
# distroless + non-root + read-only-friendly to match that posture.
#
# Build (from the repo root, so the go.work workspace is in context):
#   docker build -f Dockerfile.ebpf-source -t ghcr.io/olivaresai/ebpf-source:dev .
# Pin to a sha256 DIGEST (not a tag) in production deploy manifests.

FROM golang:1.27.1-bookworm AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-mod=readonly
# The full source comes in BEFORE `go mod download`. The go command reads go.work
# first and fails when a module it lists has no go.mod in this stage, so the stage
# loads the go.work the context really carries (the curated export ships a trimmed
# one) rather than a separate hand-kept list of module manifests.
# Accepted cache consequence: a change anywhere in the context also invalidates the
# module-download layer, not only the layers after it.
COPY . .
RUN go mod download
ARG SOURCE_DATE_EPOCH=0
RUN go build -trimpath -ldflags "-s -w -buildid=" \
      -o /out/ebpf-source ./connectors/ebpf/cmd/ebpf-source

FROM gcr.io/distroless/static-debian12:nonroot
LABEL org.opencontainers.image.title="olivares-ebpf-source" \
      org.opencontainers.image.description="Olivares AI eBPF/Tetragon backstop connector (zero kernel capabilities)" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="Olivares.AI"
COPY --from=build /out/ebpf-source /usr/local/bin/ebpf-source
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/ebpf-source"]
