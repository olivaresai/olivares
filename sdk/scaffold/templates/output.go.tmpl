// Package [[.Package]] is an Olivares AI output connector: it delivers engine
// notifications to your system (a chat channel, a ticketing system, a SIEM,
// a pager). It was generated by olivares-connector-new and is yours to edit —
// the shape (a Descriptor, Open to configure once, Notify per notification,
// Close to release) is the stable sdk.OutputConnector contract; the TODOs mark
// where your system's real delivery goes.
//
// A connector imports ONLY the Apache-2.0 SDK, never the upstream AGPL
// engine; scripts/check-boundary.sh enforces that boundary on the real build
// graph — run it in your CI. Notifications carry only non-sensitive,
// displayable fields; never log or forward anything beyond them.
package [[.Package]]

import (
	"context"
	"fmt"
	"io"
	"os"

	"github.com/olivaresai/olivares/sdk"
)

// Name is the connector's globally unique dotted identifier
// ("<vendor>.<connector>") — the value the engine registers it under.
const Name = "[[.Name]]"

// Output is the connector. A single instance is configured once in Open and
// then services every Notify.
type Output struct {
	// endpoint is the example setting declared in Descriptor().ConfigFields.
	// TODO: replace with your system's real configuration (URLs, channels, …).
	endpoint string
	// w is where Notify delivers. It defaults to stderr so the scaffold is
	// honestly end-to-end out of the box (it really delivers somewhere
	// observable); your real connector replaces this with a client for your
	// system. The test injects a buffer here to capture deliveries.
	w io.Writer
}

// Compile-time proof that Output satisfies the SDK contract.
var _ sdk.OutputConnector = (*Output)(nil)

// New returns the connector with default configuration.
func New() *Output { return &Output{w: os.Stderr} }

// Descriptor returns the connector's stable self-description: what it is,
// which SDK contract it was built against, and the settings Open reads. Mark
// credentials Secret: true — secret values are passed by reference, never
// inlined, and must never reach a log line or an error message.
func (o *Output) Descriptor() sdk.Descriptor {
	return sdk.Descriptor{
		Name:        Name,
		Version:     "0.1.0",
		APIVersion:  sdk.APIVersion,
		Type:        sdk.TypeOutput,
		Title:       "[[.Title]]",
		Description: "TODO: one line on where this connector delivers notifications.",
		Surfaces: []string{
[[- range .Surfaces]]
			"[[.]]",
[[- end]]
		},
		ConfigFields: []sdk.ConfigField{
			// TODO: declare your real settings (mark credentials Secret: true).
			{Key: "endpoint", Type: sdk.FieldString, Description: "The delivery target (example setting)."},
		},
	}
}

// Open resolves configuration, once, before any Notify. A configuration error
// (missing required setting, unreachable target) belongs HERE.
func (o *Output) Open(_ context.Context, cfg sdk.Config) error {
	o.endpoint = cfg.Get("endpoint")
	// TODO: validate settings and construct the delivery client for your
	// system here.
	return nil
}

// Notify delivers one notification and reports the outcome. Retry,
// rate-limiting and idempotency policy are the ENGINE's concern: attempt the
// delivery, return nil on success and the error on failure — never retry-loop
// here. It honors ctx so the engine can cancel an in-flight delivery.
func (o *Output) Notify(ctx context.Context, n sdk.Notification) error {
	if err := ctx.Err(); err != nil {
		return err
	}
	// TODO: replace with delivery to your system (an HTTP POST, a queue
	// publish, a ticket create, …). The write below keeps the scaffold honest:
	// it really delivers the notification somewhere observable (stderr).
	_, err := fmt.Fprintf(o.w, "[%s] %s — %s (severity=%s tenant=%s)\n",
		n.Type, n.Title, n.Body, n.Severity, n.Tenant)
	return err
}

// Close releases the connector's resources. It runs once, after the last
// Notify, and must be safe to call even if Open failed.
func (o *Output) Close(context.Context) error { return nil }
