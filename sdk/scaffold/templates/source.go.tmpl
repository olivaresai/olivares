// Package [[.Package]] is an Olivares AI [[.Template]] connector. It was
// generated by olivares-connector-new and is yours to edit — the shape (a
// Descriptor, Open to read config, Gather to emit, Close to release) is the
// stable sdk.SourceConnector contract; the TODOs mark where your system's
// real logic goes.
//
[[- if .IsAccessEdge]]
// This archetype emits EdgeObservation facts: who reached what, in which
// read/write mode, and when.
[[- else if .IsAgentSurface]]
// This archetype emits EdgeObservation facts plus FindingReport facts about an
// agent runtime. It reads endpoint/log-path style configuration; the engine
// owns the audit, findings and posture pipelines.
[[- else if .IsModelProvider]]
// This archetype emits CostSample facts plus usage EdgeObservation facts for a
// model backend. Model catalog/governance policy is engine-side; this connector
// reports observed usage and cost evidence.
[[- end]]
//
// A connector imports ONLY the Apache-2.0 SDK, never the upstream AGPL
// engine; scripts/check-boundary.sh enforces that boundary on the real build
// graph — run it in your CI.
package [[.Package]]

import (
	"context"
	"time"

	"github.com/olivaresai/olivares/sdk"
	"github.com/olivaresai/olivares/sdk/model"
)

// Name is the connector's globally unique dotted identifier
// ("<vendor>.<connector>") — the value the engine registers it under.
const Name = "[[.Name]]"

// Source is the connector. It holds the configuration Open resolved and any
// clients it needs. The engine owns scheduling: it calls Gather on a goroutine
// it controls and cancels via ctx; the connector never owns a ticker for its
// own lifecycle.
type Source struct {
[[- if .IsAgentSurface]]
	endpoint string
	logPath  string
[[- else if .IsModelProvider]]
	providerAPIBase string
[[- else]]
	endpoint string
[[- end]]
}

// Compile-time proof that Source satisfies the SDK contract.
var _ sdk.SourceConnector = (*Source)(nil)

// New returns the connector with default configuration.
func New() *Source { return &Source{} }

// Descriptor returns the connector's stable self-description: what it is,
// which SDK contract it was built against, and the settings Open reads. The
// engine validates configuration against ConfigFields without running the
// connector; a UI renders a form from them. Mark credentials Secret: true —
// secret values are passed by reference, never inlined.
func (s *Source) Descriptor() sdk.Descriptor {
	return sdk.Descriptor{
		Name:        Name,
		Version:     "0.1.0",
		APIVersion:  sdk.APIVersion,
		Type:        sdk.TypeSource,
		Title:       "[[.Title]]",
[[- if .IsAgentSurface]]
		Description: "TODO: one line on the agent runtime this connector observes.",
[[- else if .IsModelProvider]]
		Description: "TODO: one line on the model provider this connector observes.",
[[- else]]
		Description: "TODO: one line on what this connector observes.",
[[- end]]
		Surfaces: []string{
[[- range .Surfaces]]
			"[[.]]",
[[- end]]
		},
		ConfigFields: []sdk.ConfigField{
[[- if .IsAgentSurface]]
			{Key: "endpoint", Type: sdk.FieldString, Required: true, Description: "The agent-runtime control-plane endpoint."},
			{Key: "log_path", Type: sdk.FieldString, Description: "Optional path to agent-runtime audit logs."},
[[- else if .IsModelProvider]]
			{Key: "provider_api_base", Type: sdk.FieldString, Required: true, Description: "The model provider API base URL."},
			{Key: "api_key", Type: sdk.FieldString, Secret: true, Description: "Provider API credential reference."},
[[- else]]
			{Key: "endpoint", Type: sdk.FieldString, Description: "The system to observe (example setting)."},
[[- end]]
		},
	}
}

// Open resolves configuration, once, before Gather. A configuration error
// (missing required setting, unreachable target) belongs HERE, not deferred
// to Gather — the engine surfaces Open failures as wiring errors.
func (s *Source) Open(_ context.Context, cfg sdk.Config) error {
[[- if .IsAgentSurface]]
	s.endpoint = cfg.Get("endpoint")
	s.logPath = cfg.Get("log_path")
[[- else if .IsModelProvider]]
	s.providerAPIBase = cfg.Get("provider_api_base")
[[- else]]
	s.endpoint = cfg.Get("endpoint")
[[- end]]
	// TODO: validate settings and construct clients for your system here.
	return nil
}

// Gather runs the connector, emitting observations to sink. Scheduling is the
// engine's job: a batch/poll source does its work and returns nil (the engine
// decides if and when to call Gather again); a streaming source blocks here,
// emitting until ctx is done. Either way it honors ctx — the engine cancels
// it to stop the run.
//
// Delivery is at-least-once: if Gather returns an error and the engine
// restarts the source, already-emitted observations may be emitted again.
// Consumers de-duplicate on each observation's natural key, so the connector
// keeps no delivery state of its own.
func (s *Source) Gather(ctx context.Context, sink sdk.Sink) error {
	if err := ctx.Err(); err != nil {
		return err
	}
[[- if .IsAgentSurface]]
	edge := model.EdgeObservation{
		OriginKind:   "agent",
		OriginRef:    "example-agent",
		ResourceKind: "tool",
		ResourceRef:  "example-runtime/tool/read",
		Mode:         model.ModeRead,
		Source:       model.SignalOTEL,
		Confidence:   model.ConfidenceApproximate,
		ToolRef:      "example.runtime.read",
		ObservedAt:   time.Now().UTC(),
	}
	if err := sink.Emit(ctx, edge); err != nil {
		return err
	}
	finding := model.FindingReport{
		Kind:        "posture",
		Severity:    model.SeverityMedium,
		SubjectKind: "agent",
		SubjectRef:  "example-agent",
		Title:       "example agent-runtime posture finding",
		DetailHash:  "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
		OccurredAt:  time.Now().UTC(),
	}
	return sink.Emit(ctx, finding)
[[- else if .IsModelProvider]]
	cost := model.CostSample{
		ProviderRef:   "example-provider",
		ModelRef:      "example-model",
		SessionRef:    "example-session",
		InputTokens:   1200,
		OutputTokens:  300,
		CostMicroUSD:  42,
		OccurredAt:    time.Now().UTC(),
		Provenance:    model.ProvenanceEstimated,
		ServiceTier:   "standard",
		ContextWindow: "0-200k",
	}
	if err := sink.Emit(ctx, cost); err != nil {
		return err
	}
	usage := model.EdgeObservation{
		OriginKind:   "agent",
		OriginRef:    "example-agent",
		ResourceKind: "model",
		ResourceRef:  "example-provider/example-model",
		Mode:         model.ModeRead,
		Source:       model.SignalOTEL,
		Confidence:   model.ConfidenceAttributed,
		ToolRef:      "example.inference",
		ObservedAt:   time.Now().UTC(),
	}
	return sink.Emit(ctx, usage)
[[- else]]
	// TODO: replace with your system's real facts — read your audit log / API /
	// telemetry and emit one observation per fact you can honestly attest.
	obs := model.EdgeObservation{
		OriginKind:   "agent",                     // what acted: "agent", "identity" or "session"
		OriginRef:    "example-agent",             // your system's natural name for the actor
		ResourceKind: "example.resource",          // the class of resource touched
		ResourceRef:  "example/item",              // your system's natural name for the resource
		Mode:         model.ModeRead,              // read / write / readwrite classification
		Source:       model.SignalOTEL,            // TODO: the SignalSource matching your collector
		Confidence:   model.ConfidenceApproximate, // how firm the attribution is
		ToolRef:      "example.read",              // optional: the tool/operation that performed it
		ObservedAt:   time.Now().UTC(),            // when the access happened (dedup natural key)
	}
	if err := sink.Emit(ctx, obs); err != nil {
		// Emit blocks until the engine accepts or ctx is done (backpressure is
		// intentional: a slow engine slows the source rather than dropping
		// facts). Treat an Emit error as fatal to this Gather run.
		return err
	}
	return nil
[[- end]]
}

// Close releases the connector's resources. It runs once after Gather has
// returned and must be safe to call even if Open failed.
func (s *Source) Close(context.Context) error { return nil }
